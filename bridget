# ----- ia-5f66 Inject API (cross-host message injection for Robin v2.1) -----
#
# HTTP listener on 127.0.0.1 that lets the Ocean-side Robin v2.1 receiver
# script (via the existing ntfy.sh push channel from Land Bridge v1) inject
# incoming agent pings into mayor's bridget message buffer. Renders to mayor
# as `[From <sender> via Robin] <body>`, identical perception path to a
# Discord-DM from human. Full spec: docs/ia-5f66-inject-api.md.

INJECT_PORT = int(os.environ.get('BRIDGET_INJECT_PORT', '8765'))
INJECT_SECRET_FILE = HOME / '.pogo' / 'bridget.inject-secret'
INJECT_AUDIT_FILE = HOME / '.pogo' / 'bridget.inject-audit.jsonl'
INJECT_LAST_POLL_FILE = HOME / '.pogo' / 'bridget.last-poll'
INJECT_RATE_MAX = int(os.environ.get('BRIDGET_INJECT_RATE_MAX', '30'))
INJECT_RATE_WINDOW = int(os.environ.get('BRIDGET_INJECT_RATE_WINDOW', '60'))
INJECT_MAX_BODY = 4096
INJECT_TS_SKEW_SEC = 300
INJECT_MAYOR_DOWN_SEC = 300

_inject_rate_state: dict[str, deque] = {}


def _load_inject_secret() -> str | None:
    """Return HMAC secret from ~/.pogo/bridget.inject-secret, or None if
    unconfigured. File shape: one line `SECRET=<hex>` (mode 0600 expected)."""
    if not INJECT_SECRET_FILE.exists():
        return None
    try:
        for raw in INJECT_SECRET_FILE.read_text().splitlines():
            line = raw.strip()
            if line.startswith('SECRET='):
                return line[len('SECRET='):].strip()
    except OSError as e:
        _log(f'inject secret read failed: {e}')
    return None


def _inject_audit(audit_id: str, sender: str, body_size: int,
                  body_sha16: str, status: str, reason: str | None = None) -> None:
    """Append one JSONL audit line. Body content NOT logged, only sha hash."""
    ts = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    line = json.dumps({
        'ts': ts,
        'audit_id': audit_id,
        'from': sender,
        'body_sha256_first16': body_sha16,
        'body_bytes': body_size,
        'status': status,
        'rejected_reason': reason,
    })
    try:
        with open(INJECT_AUDIT_FILE, 'a') as f:
            f.write(line + '\n')
    except OSError as e:
        _log(f'inject audit write failed: {e}')


def _inject_rate_check(sender: str) -> tuple[bool, int]:
    """Sliding-window per-sender rate check. Returns (ok, retry_after_seconds)."""
    now = time.time()
    dq = _inject_rate_state.setdefault(sender, deque())
    while dq and dq[0] < now - INJECT_RATE_WINDOW:
        dq.popleft()
    if len(dq) >= INJECT_RATE_MAX:
        retry = int(INJECT_RATE_WINDOW - (now - dq[0])) + 1
        return False, max(retry, 1)
    dq.append(now)
    return True, 0


def _mayor_poll_age_seconds() -> int | None:
    """Read ~/.pogo/bridget.last-poll for the most recent mayor-side
    poll-cycle timestamp; return seconds since that, or None if missing."""
    if not INJECT_LAST_POLL_FILE.exists():
        return None
    try:
        ts_str = INJECT_LAST_POLL_FILE.read_text().strip()
        last = datetime.datetime.fromisoformat(ts_str.replace('Z', '+00:00'))
        now = datetime.datetime.now(datetime.timezone.utc)
        return int((now - last).total_seconds())
    except (OSError, ValueError):
        return None


async def _inject_handler(request):
    import aiohttp.web  # local import; avoid module-level dep at parse time
    audit_id = uuid.uuid4().hex

    secret = _load_inject_secret()
    if not secret:
        _inject_audit(audit_id, 'unknown', 0, '', 'rejected_misconfigured', 'no_secret')
        return aiohttp.web.json_response(
            {'error': 'inject not configured (missing ~/.pogo/bridget.inject-secret)'},
            status=503,
        )

    sender = request.headers.get('X-Robin-Sender', '').strip()
    recipient = request.headers.get('X-Robin-Recipient', 'mayor').strip()
    ts_str = request.headers.get('X-Robin-Ts', '').strip()
    mac_hex = request.headers.get('X-Robin-Hmac', '').strip().lower()

    body_raw = await request.read()
    body_size = len(body_raw)

    if body_size > INJECT_MAX_BODY:
        _inject_audit(audit_id, sender or 'unknown', body_size, '',
                      'rejected_too_large', 'too_large')
        return aiohttp.web.json_response({'error': 'too large'}, status=413)

    if not sender or not ts_str or not mac_hex:
        _inject_audit(audit_id, sender or 'unknown', body_size, '',
                      'rejected_malformed', 'malformed')
        return aiohttp.web.json_response(
            {'error': 'missing required header (X-Robin-Sender, X-Robin-Ts, X-Robin-Hmac)'},
            status=400,
        )

    if not re.match(r'^[a-z][a-z0-9_-]{0,63}$', sender):
        _inject_audit(audit_id, 'invalid', body_size, '', 'rejected_malformed', 'malformed')
        return aiohttp.web.json_response({'error': 'bad sender shape'}, status=400)

    # Ts is ISO8601 UTC with millisecond precision (matches Ocean's
    # cross_host_ping iso_now_ms() format: YYYY-MM-DDTHH:MM:SS.mmmZ).
    # Bridget keeps the raw string as the HMAC-input field; only parses
    # for the skew check.
    try:
        ts_dt = datetime.datetime.fromisoformat(ts_str.replace('Z', '+00:00'))
    except ValueError:
        _inject_audit(audit_id, sender, body_size, '', 'rejected_malformed', 'malformed')
        return aiohttp.web.json_response({'error': 'bad ts (expect ISO8601 with ms)'}, status=400)

    now_dt = datetime.datetime.now(datetime.timezone.utc)
    skew_sec = abs((now_dt - ts_dt).total_seconds())
    if skew_sec > INJECT_TS_SKEW_SEC:
        _inject_audit(audit_id, sender, body_size, '', 'rejected_auth', 'auth')
        return aiohttp.web.json_response({'error': 'auth (ts skew)'}, status=401)
    ts = ts_str  # keep string form for HMAC input

    # HMAC scheme matches Ocean's robin-ping cross_host_ping.auth.compute_hmac:
    # SHA-256 over "sender|recipient|ts|message" UTF-8. Receiver script
    # passes Ocean's headers through unchanged; bridget verifies against
    # the same secret (shared bearer between Ocean and Mac sides).
    try:
        body_str_for_hmac = body_raw.decode('utf-8')
    except UnicodeDecodeError:
        body_sha16 = hashlib.sha256(body_raw).hexdigest()[:16]
        _inject_audit(audit_id, sender, body_size, body_sha16,
                      'rejected_malformed', 'malformed')
        return aiohttp.web.json_response({'error': 'bad utf8'}, status=400)
    expected_mac = hmac.new(
        secret.encode('utf-8'),
        f'{sender}|{recipient}|{ts}|{body_str_for_hmac}'.encode('utf-8'),
        hashlib.sha256,
    ).hexdigest()
    if not hmac.compare_digest(expected_mac, mac_hex):
        body_sha16 = hashlib.sha256(body_raw).hexdigest()[:16]
        _inject_audit(audit_id, sender, body_size, body_sha16, 'rejected_auth', 'auth')
        return aiohttp.web.json_response({'error': 'auth'}, status=401)

    body_sha16 = hashlib.sha256(body_raw).hexdigest()[:16]

    ok, retry = _inject_rate_check(sender)
    if not ok:
        _inject_audit(audit_id, sender, body_size, body_sha16,
                      'rejected_rate_limit', 'rate_limit')
        return aiohttp.web.json_response(
            {'error': 'rate limit', 'retry_after_seconds': retry},
            status=429,
        )

    body_str = body_str_for_hmac

    # Mayor-down detection removed (ia-5f66 follow-on, 2026-05-25). The
    # original 300s last-poll threshold was meant to detect "mayor's not
    # polling so buffer entries would sit unread" — but the nudge-after-
    # inject path (line below) actively wakes mayor on every successful
    # delivery, making time-based mayor-down detection redundant + harmful:
    # legit pings during mayor's long-sleep windows were being rejected
    # with 503 while the nudge would have woken mayor and delivered fine.
    # If mayor is truly dead, the nudge silently fails but the buffer
    # entry is still durable for when mayor recovers, AND the audit log
    # captures the attempt — both better signals than the time-based gate.

    try:
        count = append_chat_buffer('mayor', f'[From {sender} via Robin] {body_str}')
    except Exception as e:  # noqa: BLE001
        _inject_audit(audit_id, sender, body_size, body_sha16,
                      'rejected_buffer_write_failed', 'internal')
        return aiohttp.web.json_response({'error': f'buffer write failed: {e}'}, status=500)

    # Wake mayor with a pogo-nudge so the inject perception path matches
    # the Discord-DM path. Without this, the buffer entry sits unread
    # until mayor's next scheduled wakeup — which can be 1h+ during
    # ambient watch, defeating the sub-second cross-host ping intent.
    # Failures to nudge are logged but do not fail the inject: the
    # buffer write is the durable record + the audit captures the state.
    plural = '' if count == 1 else 's'
    nudge_msg = f'{count} new bridget message{plural}'
    try:
        rc, _out, err = run_pogo(['nudge', '--immediate', 'mayor', nudge_msg])
        if rc != 0:
            _log(f'inject nudge failed for audit {audit_id}: {(err or "").strip()[:200]}')
    except Exception as e:  # noqa: BLE001
        _log(f'inject nudge raised for audit {audit_id}: {e}')

    _inject_audit(audit_id, sender, body_size, body_sha16, 'delivered')
    return aiohttp.web.json_response({'delivered': True, 'audit_id': audit_id}, status=200)


async def _run_inject_api():
    """Start the loopback HTTP listener for cross-host message injection.

    Best-effort: bind failures (port in use, etc.) log + return so the
    rest of bridget keeps running. The listener lives for the lifetime
    of the asyncio loop."""
    try:
        import aiohttp.web
    except ImportError as e:
        _log(f'inject API not started: aiohttp missing ({e}). pip install aiohttp>=3.9')
        return
    app = aiohttp.web.Application()
    app.router.add_post('/v1/inject', _inject_handler)
    runner = aiohttp.web.AppRunner(app)
    await runner.setup()
    site = aiohttp.web.TCPSite(runner, '127.0.0.1', INJECT_PORT)
    try:
        await site.start()
        _log(f'inject API listening on 127.0.0.1:{INJECT_PORT}')
    except OSError as e:
        _log(f'inject API failed to bind on 127.0.0.1:{INJECT_PORT}: {e}')


@client.event
async def on_ready():
    global _watchers_started, _slash_synced
    _log(f'on_ready fired (pid={os.getpid()}, _watchers_started={_watchers_started})')
    print(f"logged in as {client.user} (id={client.user.id})", flush=True)
    # Re-assert presence on every ready fire, including reconnect re-fires
    # (before the _watchers_started guard below) — see mg-beb5.
    await _assert_presence('on_ready')
    if _watchers_started:
        print("on_ready re-fired (reconnect); watchers already running", flush=True)
        return
    try:
        user = await client.fetch_user(USER_ID)
    except discord.NotFound:
        print(f"user {USER_ID} not found", file=sys.stderr)
        await client.close()
        return
    # Sync slash-command registration with Discord on first connect (mg-db57).
    # Best-effort: a sync failure logs + continues so an unreachable Discord
    # commands API doesn't block the watcher spawn below. Guarded by
    # `_slash_synced` so reconnects don't burn the global-registration
    # rate limit re-uploading the same tree.
    if not _slash_synced:
        try:
            synced = await tree.sync()
            _log(f'synced {len(synced)} slash command(s)')
            _slash_synced = True
        except Exception as exc:  # noqa: BLE001
            _log(f'slash-command sync failed: {exc}')
    client.loop.create_task(watch_mailbox(user))
    client.loop.create_task(watch_task_transitions(user))
    client.loop.create_task(watch_idea_claims(user))
    client.loop.create_task(watch_chat(user))
    client.loop.create_task(_run_inject_api())
    _watchers_started = True


@client.event
async def on_resumed():
    # A RESUMEd session skips on_ready, so a sleep-driven gateway drop can
    # leave Discord showing stale offline presence while DMs still flow
    # both ways. Re-assert online on every resume (mg-beb5).
    await _assert_presence('on_resumed')


@client.event
async def on_message(message: discord.Message):
    if message.author.bot:
        return
    if message.author.id != USER_ID:
        return
    if not isinstance(message.channel, discord.DMChannel):
        return
    # Ingest attachments before dispatch (ds-ff7c): image/* + PDF go to
    # the chat-relay buffer alongside the body, oversized ones get a
    # one-line warn-reply + a rejected entry. Slash and known-verb
    # commands don't accept attachments — those are dropped with a
    # separate warning so the user knows to resend as plain chat if
    # they meant to share a file.
    text = message.content.strip()
    is_command = text.startswith('/') or (text and _is_known_verb(text))
    attachments_present = bool(getattr(message, 'attachments', None))
    if attachments_present and is_command:
        try:
            await message.reply(
                '⚠️ attachments dropped — commands do not accept '
                'attachments; resend as chat-relay if you meant to share'
            )
        except discord.HTTPException as e:
            _log(f'on_message attachments-dropped warn failed: {e}')
        reply = handle_command(message.content)
    elif attachments_present:
        ingested = await _ingest_attachments(message)
        reply = _route_to_chat_relay(message.content, attachments=ingested)
    else:
        reply = handle_command(message.content)
    chunks = reply if isinstance(reply, list) else [reply]
    try:
        for i, chunk in enumerate(chunks):
            if i > 0:
                await asyncio.sleep(DM_CHUNK_DELAY)
            await send_dm_chunked(message.channel, chunk)
    except discord.HTTPException as e:
        _log(f'HTTPException in on_message reply send: {e}')


