def load_route() -> str:
    """Read ~/.pogo/bridget-route.json. Missing/corrupt/unknown-agent → DEFAULT_ROUTE.

    "Unknown" is resolved against discovery (mg-4d10), so a route persisted
    before its target was retired self-heals back to mayor on the next read
    instead of pointing at an agent that can no longer be started."""
    if not ROUTE_FILE.exists():
        return DEFAULT_ROUTE
    try:
        d = json.loads(ROUTE_FILE.read_text())
    except Exception as e:
        print(f'load_route parse error: {e}', file=sys.stderr)
        return DEFAULT_ROUTE
    if not isinstance(d, dict):
        return DEFAULT_ROUTE
    agent = d.get('route')
    if not isinstance(agent, str) or agent not in known_route_agents():
        return DEFAULT_ROUTE
    return agent


