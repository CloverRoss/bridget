def format_transition(task: dict, new_status: str):
    fmt = _TRANSITION_FORMATS.get(new_status)
    if fmt is None:
        return None
    title = (task.get('title') or '?')[:80]
    by = ''
    if new_status == 'claimed':
        assignee = (task.get('assignee') or '').strip()
        if assignee and assignee.lower() not in _NON_POLECAT_ASSIGNEES:
            by = f' by {assignee}'
    return fmt.format(id=task.get('id', '?'), by=by, title=title)


def humanize_ago(seconds: float) -> str:
    """Compact 'time ago' formatter."""
    s = int(seconds)
    if s < 60:
        return 'just now'
    if s < 3600:
        return f'{s // 60}m ago'
    if s < 86400:
        return f'{s // 3600}h ago'
    return f'{s // 86400}d ago'


def _humanize_seconds(seconds: float) -> str:
    s = int(seconds)
    if s < 60:
        return f'{s}s'
    if s < 3600:
        m, sec = divmod(s, 60)
        return f'{m}m{sec:02d}s'
    h, rem = divmod(s, 3600)
    return f'{h}h{rem // 60}m'


def _parse_iso_utc(ts: str) -> datetime.datetime:
    if ts.endswith('Z'):
        ts = ts[:-1] + '+00:00'
    return datetime.datetime.fromisoformat(ts).astimezone(datetime.timezone.utc)


def fetch_mg_claims_by_assignee() -> dict[str, list[str]]:
    """Return {assignee_name: [mg_id, ...]} for items currently in 'claimed'
    status. One shellout per agents-command invocation. Errors return {}
    silently — the renderer degrades to 'no badge', not 'no row'."""
    rc, out, _ = run_mg(['list', '--status=claimed', '--json'])
    if rc != 0:
        return {}
    by_assignee: dict[str, list[str]] = {}
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        assignee = item.get('assignee')
        iid = item.get('id')
        if not assignee or not iid:
            continue
        by_assignee.setdefault(assignee, []).append(iid)
    return by_assignee


def _read_fresh_status_raw(name: str) -> str | None:
    """Return the agent's self-reported `state` field from
    ~/.pogo/agent-status/<name>.json, IFF the file's mtime is within
    AGENT_STATUS_FRESH (2 minutes by default).

    Returns None for: missing file, unreadable mtime, mtime past
    AGENT_STATUS_FRESH, unparseable JSON, or missing/non-string state."""
    path = AGENT_STATUS_DIR / f'{name}.json'
    try:
        st = path.stat()
    except (FileNotFoundError, OSError):
        return None
    age = datetime.datetime.now(datetime.timezone.utc).timestamp() - st.st_mtime
    if age > AGENT_STATUS_FRESH.total_seconds():
        return None
    try:
        data = json.loads(path.read_text())
    except Exception:
        return None
    raw = data.get('state')
    return raw if isinstance(raw, str) else None


def _state_from_diag(name: str, diag: dict) -> dict:
    """Convert a parsed diagnose dict into the compute_agent_state result.

    Split out from compute_agent_state so tests can exercise the mapping
    without mocking subprocess calls.

    `healthy` is the only health that consults the JSON: pogod's diagnose
    returns healthy for any alive crew agent, so the agent's self-reported
    state (fresh ≤ AGENT_STATUS_FRESH, prefix `busy:`) is the tiebreaker
    between busy and idle (mg-9939)."""
    health = (diag.get('health') or '').lower()
    idle_duration = diag.get('idle_duration') or '?'
    if health == 'healthy':
        raw = _read_fresh_status_raw(name)
        if raw is not None and raw.startswith('busy:'):
            label = raw.split(':', 1)[1].strip() or None
            return {
                'state': 'busy',
                'health_raw': health,
                'badge': label,
                'idle_duration': idle_duration,
            }
        return {
            'state': 'idle',
            'health_raw': health,
            'badge': None,
            'idle_duration': idle_duration,
        }
    state = HEALTH_TO_STATE.get(health)
    if state is None:
        print(
            f'bridget: unknown diagnose health {health!r} for agent {name!r}; '
            f'treating as stalled',
            file=sys.stderr,
        )
        return {
            'state': 'stalled',
            'health_raw': health,
            'badge': None,
            'idle_duration': idle_duration,
        }
    return {
        'state': state,
        'health_raw': health,
        'badge': None,
        'idle_duration': idle_duration,
    }


def compute_agent_state(name: str) -> dict:
    """Derive an agent's state from `pogo agent diagnose <name> --json`.

    Returns a dict:
        {
          'state':         'busy' | 'idle' | 'stalled' | 'offline',
          'health_raw':    raw pogo diagnose health string (or '' on error),
          'badge':         self-reported label from
                           ~/.pogo/agent-status/<name>.json IFF
                           state == 'busy' AND the JSON mtime ≤
                           AGENT_STATUS_FRESH (2 min); else None.
                           A diagnose-failure also borrows this slot for a
                           faded '(diagnose failed)' suffix.
          'idle_duration': human-readable duration from diagnose (or '?').
        }

    Hard rules:
      • For health=healthy, the agent's self-reported JSON state field is
        the busy/idle tiebreaker (mg-9939). State=busy iff the JSON's
        `state` starts with 'busy:' AND its mtime is ≤ AGENT_STATUS_FRESH;
        otherwise state=idle. (pogod's diagnose returns healthy for any
        alive crew agent, so without the tiebreaker every alive agent
        renders as busy — the mg-eb6e regression this fixes.)
      • For health=stalled|exited|dead, the JSON is not consulted.
      • Badge appears only when state == 'busy' AND JSON state has the
        form 'busy: <label>' — bare 'busy:' yields no badge. This kills
        the "busy: drafted mg-XXXX persists for an hour after the agent
        went back to sleep" pain.
      • Diagnose failure for a known-running agent → state='offline' with
        a '(diagnose failed)' badge — explicitly drops the v3.1.0 'busy
        by default' rule. A wedged or unreachable agent now reads as
        offline, not busy."""
    rc, out, _ = run_pogo(['agent', 'diagnose', name, '--json'])
    if rc != 0:
        return {
            'state': 'offline',
            'health_raw': '',
            'badge': '(diagnose failed)',
            'idle_duration': '?',
        }
    try:
        diag = json.loads(out)
    except json.JSONDecodeError as e:
        print(
            f'bridget: diagnose JSON parse error for agent {name!r}: {e}',
            file=sys.stderr,
        )
        return {
            'state': 'stalled',
            'health_raw': '',
            'badge': None,
            'idle_duration': '?',
        }
    return _state_from_diag(name, diag)


def agent_state(name: str, agent_list_entry: dict,
                mg_claims: dict[str, list[str]]) -> tuple[str, str, str | None]:
    """Return (emoji, label, badge) for one agent row.

    emoji  ∈ {'🟢', '🟡', '🔴', '⚪'}
    label  ∈ {'idle', 'busy', 'stalled', 'offline'}
    badge  optional trailing string (mg-id, self-report label, or a faded
           '(diagnose failed)' suffix) or None.

    Decision tree (priority order):
        process != 'running'             → ('⚪', 'offline', None)
        type set and type != 'crew'      → ('🟡', 'busy', <claimed mg-id> or None)
        otherwise (crew agent, running)  → derived from compute_agent_state(name)

    For crew agents, state derives from `pogo agent diagnose` health plus
    a JSON-state tiebreaker on `healthy` (see compute_agent_state). The
    badge — when present — is the agent's self-reported JSON label, shown
    only when derived state is 'busy' AND the JSON state has the form
    'busy: <label>' AND its mtime is within AGENT_STATUS_FRESH.

    Polecats and other non-crew agents are ephemeral per-task processes
    that don't write `~/.pogo/agent-status/<name>.json`, so they
    short-circuit to 🟡 busy with the claimed mg-id as a badge. (Their
    per-task state is already tracked by the mg work-item status.)"""
    process = (agent_list_entry.get('status') or '').lower()
    if process != 'running':
        return ('⚪', 'offline', None)
    agent_type = (agent_list_entry.get('type') or '').lower()
    if agent_type and agent_type != 'crew':
        claims = mg_claims.get(name) or []
        badge = claims[0] if claims else None
        return ('🟡', 'busy', badge)
    derived = compute_agent_state(name)
    state = derived['state']
    return (STATE_EMOJI[state], state, derived['badge'])


def agent_cycle_paren(name: str) -> str:
    """Return '(last cycle X ago, next cycle in Y)' read from
    ~/.pogo/agent-status/<name>.json, or '(last cycle ?, next cycle ?)' if the
    file is missing, malformed, or its updated_at is older than 30 minutes."""
    try:
        data = json.loads((AGENT_STATUS_DIR / f'{name}.json').read_text())
        last = _parse_iso_utc(data['last_cycle'])
        nxt = _parse_iso_utc(data['next_cycle'])
        updated = _parse_iso_utc(data['updated_at'])
        now = datetime.datetime.now(datetime.timezone.utc)
        if now - updated > AGENT_STATUS_STALE:
            return '(last cycle ?, next cycle ?)'
        last_ago = _humanize_seconds(max(0, (now - last).total_seconds()))
        delta = (nxt - now).total_seconds()
        if delta < 0:
            return f'(last cycle {last_ago} ago, next cycle overdue {_humanize_seconds(-delta)})'
        return f'(last cycle {last_ago} ago, next cycle in {_humanize_seconds(delta)})'
    except Exception:
        return '(last cycle ?, next cycle ?)'


