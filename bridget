# --- chat CLI (mg-c05a — Robin port item 6) -------------------------------
#
# `bridget chat <agent_name> <body...>` drops a maildir-style file into
# BRIDGET_CHAT_DIR/new/. The running bridget daemon's watch_chat() task
# polls that dir and emits each entry as a DM in `[From <agent>]: <body>`
# form, then moves the file to cur/ (the move is the dedup mechanism).
#
# Sender attribution comes from the explicit <agent_name> argument — the
# crew agent or polecat invoking the CLI is responsible for passing its
# own name, not derived from any process identity. This mirrors Robin's
# robin-CLI pattern (/opt/pogo/robin/bin/robin).
#
# Body is joined from all remaining positional args with single spaces.
# Long bodies are kept whole here; the daemon-side send uses
# send_dm_chunked which splits across multiple DMs at paragraph / line /
# fence boundaries (mg-a3ef).

def write_chat_drop(
    agent_name: str,
    body: str,
    inbox_dir: Path | None = None,
    attachments: list[Path] | None = None,
) -> Path:
    """Drop a chat-mail file for the bridget daemon to pick up.

    File format: `From: <agent>\\nDate: <iso>\\n[Attachments: <path>\\n
    <path>...\\n]\\n<body>\\n` — the same minimal mail envelope
    parse_mail() already understands plus an optional `Attachments:`
    multi-line header (ds-ff7c). Returns the final path. Filename is
    `<ns>.<pid>.<safe-agent>` where `safe-agent` has non-`[A-Za-z0-9._-]`
    chars collapsed to `_` so a hostile sender name can't traverse the
    filesystem.

    `attachments`, when supplied, is a list of absolute Paths to files
    in CHAT_ATTACHMENTS_DIR (the CLI is expected to have already
    sha256+copied them there). The daemon-side reader parses the
    header, reattaches them as discord.File objects on the outbound DM,
    and writes an error chat-buffer entry back if the 25MB total cap
    is exceeded.

    Uses a `<final>.tmp` write-then-rename so the daemon never sees a
    partially-written file in new/.
    """
    inbox = (inbox_dir or BRIDGET_CHAT_DIR) / 'new'
    inbox.mkdir(parents=True, exist_ok=True)
    safe = CHAT_FILENAME_AGENT_RE.sub('_', agent_name) or 'unknown'
    ts = time.time_ns()
    fname = f'{ts}.{os.getpid()}.{safe}'
    tmp = inbox / (fname + '.tmp')
    final = inbox / fname
    now_iso = datetime.datetime.now(datetime.timezone.utc).strftime(
        '%Y-%m-%dT%H:%M:%SZ'
    )
    headers = [f'From: {agent_name}', f'Date: {now_iso}']
    if attachments:
        # Each path goes on its own line under the Attachments: header.
        # Continuation lines start with whitespace so parse_mail's split-
        # on-blank-line still finds the body boundary correctly.
        att_lines = [str(p) for p in attachments]
        headers.append('Attachments: ' + att_lines[0])
        for extra in att_lines[1:]:
            headers.append(' ' + extra)
    content = '\n'.join(headers) + '\n\n' + body + '\n'
    tmp.write_text(content, encoding='utf-8')
    os.rename(tmp, final)
    return final


# --- agent discovery for /route targeting (mg-4d10) ---------------------
#
# Everything here must work from the `bridget chat …` CLI fast-path, which
# short-circuits before load_config() — so no CONFIG access at import time
# and no run_pogo (which is defined further down and reads CONFIG).

# Route target statuses, ordered from "message will be read" to "message
# will rot on disk".
ROUTE_STATUS_RUNNING = 'running'    # process is up; it will drain
ROUTE_STATUS_STOPPED = 'stopped'    # startable prompt, but nothing running
ROUTE_STATUS_RETIRED = 'retired'    # no prompt on the scan path, not running
ROUTE_STATUS_UNKNOWN = 'unknown'    # startable; pogod unreachable, can't tell

_running_agents_cache: tuple[float, set[str] | None] | None = None


def _pogo_bin() -> str | None:
    """Resolve the pogo binary without requiring CONFIG.

    The chat CLI fast-path runs before load_config(), so CONFIG may not
    exist yet; globals().get keeps this a lookup rather than a NameError."""
    cfg = globals().get('CONFIG') or {}
    return cfg.get('pogo_bin') or os.environ.get('POGO_BIN') or shutil.which('pogo')


def discover_startable_agents() -> set[str]:
    """Names pogod could start, read straight off its prompt scan path.

    Mirrors pogo's internal/agent.ListPrompts(): the mayor prompt at
    ~/.pogo/agents/mayor.md plus every ~/.pogo/agents/crew/*.md. The `.md`
    suffix is load-bearing — retiring an agent by renaming its prompt to
    `designer.md.disabled` (or moving the directory aside) takes it off
    the scan path, which is exactly the retirement signal the old
    hardcoded tuple could not see. Templates are excluded: polecat
    templates are not crew agents."""
    names: set[str] = set()
    try:
        if (POGO_AGENTS_DIR / 'mayor.md').is_file():
            names.add('mayor')
    except OSError:
        pass
    try:
        for entry in (POGO_AGENTS_DIR / 'crew').iterdir():
            if entry.is_file() and entry.name.endswith('.md'):
                names.add(entry.name[:-len('.md')])
    except OSError:
        pass  # missing/unreadable crew dir → nothing startable there
    return names


def _probe_running_agents() -> set[str] | None:
    """Ask pogod which agents are up. None when it can't be determined.

    None is deliberately distinct from the empty set: "pogod is
    unreachable" must not be reported to the user as "your agent is
    dead", and must not trigger the dead-letter sweep.

    POGO_BRIDGET_RUNNING_AGENTS overrides the probe entirely (testing —
    same idiom as POGO_BRIDGET_CHAT_DIR): `-` forces the unreachable
    answer, anything else is a comma-separated set of running names, and
    the empty string means "nothing is running". The test suite defaults
    it to `-` so no test ever queries the live pogod (tests/conftest.py).
    """
    override = os.environ.get('POGO_BRIDGET_RUNNING_AGENTS')
    if override is not None:
        if override.strip() == '-':
            return None
        return {n.strip() for n in override.split(',') if n.strip()}
    pogo_bin = _pogo_bin()
    if not pogo_bin:
        return None
    try:
        r = subprocess.run(
            [pogo_bin, 'agent', 'list', '--json'],
            capture_output=True, text=True, timeout=10,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout or '[]')
    except Exception:
        return None
    if not isinstance(data, list):
        return None
    out: set[str] = set()
    for item in data:
        if not isinstance(item, dict):
            continue
        name = item.get('name')
        status = item.get('status')
        if isinstance(name, str) and name and status == 'running':
            out.add(name)
    return out


def discover_running_agents(max_age_sec: float | None = None) -> set[str] | None:
    """Cached _probe_running_agents. None when pogod can't be reached.

    Cached for ROUTE_LIVENESS_CACHE_SEC so a burst of DMs doesn't fork a
    pogo per message; a stale-by-seconds liveness answer is fine for
    deciding whether to warn."""
    global _running_agents_cache
    ttl = ROUTE_LIVENESS_CACHE_SEC if max_age_sec is None else max_age_sec
    now = time.monotonic()
    if _running_agents_cache is not None:
        stamped, cached = _running_agents_cache
        if now - stamped < ttl:
            return set(cached) if cached is not None else None
    result = _probe_running_agents()
    _running_agents_cache = (now, set(result) if result is not None else None)
    return set(result) if result is not None else None


def reset_running_agents_cache() -> None:
    """Drop the liveness cache (tests; and after a route change so the
    next send re-checks immediately)."""
    global _running_agents_cache
    _running_agents_cache = None


def known_route_agents() -> set[str]:
    """Every name /route will accept.

    Startable prompts, plus whatever is actually running — a live polecat
    has no crew prompt but does drain its buffer, so routing to one is
    legitimate. DEFAULT_ROUTE is always included so a fresh install with
    no ~/.pogo/agents yet can still reach mayor."""
    names = discover_startable_agents()
    running = discover_running_agents()
    if running:
        names |= running
    names.add(DEFAULT_ROUTE)
    return names


def route_target_status(agent: str) -> str:
    """Classify a route target: running / stopped / retired / unknown."""
    running = discover_running_agents()
    if running is not None and agent in running:
        return ROUTE_STATUS_RUNNING
    startable = discover_startable_agents()
    if agent not in startable and agent != DEFAULT_ROUTE:
        # No prompt on the scan path and not running: pogod has no way to
        # start it. This is the retired case that black-holed messages.
        return ROUTE_STATUS_RETIRED
    if running is None:
        return ROUTE_STATUS_UNKNOWN
    return ROUTE_STATUS_STOPPED


def describe_route_targets() -> str:
    """Human-readable menu of route targets for /route replies, split by
    liveness so the user can see at a glance which ones will answer."""
    running = discover_running_agents()
    startable = discover_startable_agents() | {DEFAULT_ROUTE}
    if running is None:
        return (
            'Known agents (pogod unreachable — liveness unknown): '
            + ', '.join(sorted(startable))
        )
    live = sorted(startable & running) + sorted(running - startable)
    idle = sorted(startable - running)
    lines = []
    lines.append('Running (will read your messages): '
                 + (', '.join(live) if live else '— none —'))
    if idle:
        lines.append('Stopped (messages will queue unread): ' + ', '.join(idle))
    return '\n'.join(lines)


# --- chat-relay buffer (mg-c869 — Robin port item 1) --------------------
#
# User → Bridget (non-slash DM) → buffer for current /route target →
# `pogo nudge <agent> "N new bridget messages"` → agent runs
# `bridget chat read <agent>` to drain. The reverse direction (agent →
# user DM) goes through write_chat_drop above (mg-c05a).
#
# Storage: a single JSON file at CHAT_BUFFER_FILE keyed by recipient
# agent: `{agent: [{"ts": iso-utc, "body": "..."}, ...]}`. Read-modify-
# write happens under an fcntl exclusive lock on CHAT_BUFFER_LOCK so the
# daemon's async append doesn't race the agent-side drain CLI.

def _load_chat_buffer_unlocked() -> dict:
    """Read CHAT_BUFFER_FILE. Returns {} on missing/corrupt/non-dict. Caller
    must hold the buffer lock; for casual reads use _with_chat_buffer_lock."""
    if not CHAT_BUFFER_FILE.exists():
        return {}
    try:
        data = json.loads(CHAT_BUFFER_FILE.read_text())
    except Exception as e:
        print(f'load_chat_buffer parse error: {e}', file=sys.stderr)
        return {}
    if not isinstance(data, dict):
        return {}
    # Drop any per-agent entry that isn't a list, defensively.
    return {k: v for k, v in data.items() if isinstance(v, list)}


def _save_chat_buffer_unlocked(buf: dict) -> None:
    """Atomically write CHAT_BUFFER_FILE. Caller must hold the buffer lock."""
    CHAT_BUFFER_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = CHAT_BUFFER_FILE.parent / (CHAT_BUFFER_FILE.name + '.tmp')
    tmp.write_text(json.dumps(buf, indent=2, sort_keys=True) + '\n')
    os.replace(tmp, CHAT_BUFFER_FILE)


def _with_chat_buffer_lock(callback):
    """Run callback(buffer_dict) under an fcntl.flock-serialized read-modify-
    write cycle. Loads the buffer, hands the dict to callback (which may
    mutate it), persists, returns callback's return value.

    The lock file is a separate sentinel (CHAT_BUFFER_LOCK) so the data
    file's atomic rename doesn't unlink the active lock handle."""
    import fcntl
    CHAT_BUFFER_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CHAT_BUFFER_LOCK, 'w') as lock_fh:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX)
        try:
            buf = _load_chat_buffer_unlocked()
            result = callback(buf)
            _save_chat_buffer_unlocked(buf)
            return result
        finally:
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)


# Inbound attachment size cap (ds-ff7c — Robin v3.0 image+PDF relay).
# Discord caps free-tier user uploads at 25 MiB, so anything larger is
# effectively unreachable through the DM path anyway. We hard-reject at
# >25 MiB rather than silently truncating: the user gets a one-line
# warning reply AND a `rejected: too_large` entry in the next chat-buffer
# append so the receiving agent sees the rejection without needing a
# second channel.
CHAT_ATTACHMENT_SIZE_LIMIT = 25 * 1024 * 1024
# Standalone PDF page-count probe: scan for `/Type /Pages` then the next
# `/Count N`. Tolerant of whitespace because real PDFs differ; falls back
# to None on no-match, encrypted PDFs, linearized variants. The body
# field is "best-effort metadata", never load-bearing.
_PDF_PAGE_COUNT_RE = re.compile(
    rb'/Type\s*/Pages[^]]{0,512}?/Count\s+(\d+)',
    re.DOTALL,
)
# Extension hint per mime, used when the Discord filename is missing or
# extension-less. We don't trust user filenames blindly (path traversal)
# — write_chat_drop has its own sanitizer, but here the on-disk filename
# is sha256+ext so there's nothing user-controlled left in it.
_MIME_TO_EXT = {
    'image/png': '.png',
    'image/jpeg': '.jpg',
    'image/gif': '.gif',
    'image/webp': '.webp',
    'image/bmp': '.bmp',
    'image/svg+xml': '.svg',
    'image/tiff': '.tiff',
    'application/pdf': '.pdf',
}


def _probe_pdf_page_count(data: bytes) -> int | None:
    """Best-effort stdlib PDF page-count from raw bytes. Returns None on
    any failure — caller treats absence as "unknown", not "error"."""
    try:
        m = _PDF_PAGE_COUNT_RE.search(data)
        if m:
            return int(m.group(1))
    except Exception:
        return None
    return None


def _attachment_ext(att, mime: str) -> str:
    """Pick a file extension for the cached attachment. Prefer the
    sender-supplied filename suffix (covers obscure image/* subtypes),
    otherwise fall back to a mime → ext table, otherwise `.bin`."""
    name = getattr(att, 'filename', None) or ''
    if '.' in name:
        ext = '.' + name.rsplit('.', 1)[1].lower()
        # cap extension to a sane shape so a hostile filename like
        # `foo.<200chars>` doesn't grow the cache path unboundedly.
        if re.fullmatch(r'\.[A-Za-z0-9]{1,8}', ext):
            return ext
    return _MIME_TO_EXT.get(mime, '.bin')


async def _ingest_attachments(message) -> list[dict]:
    """Download, validate, and cache attachments from a Discord message.

    Mime gate: image/* (broader than Robin v3.0's jpg/png/gif/webp set —
    intentional Land delta; the receiving agent's vision model decides
    what it can actually read) + application/pdf. Other types are
    silently dropped (no warn — most Discord messages don't carry
    attachments at all, so a `(no relayed file)` notice would be noise).

    Size gate: >25 MiB → one-line warn-reply to the user AND a
    {rejected: 'too_large'} entry in the returned list so the receiving
    agent sees the rejection on its next buffer drain. Smaller files
    are downloaded via `await attachment.read()` and cached at
    CHAT_ATTACHMENTS_DIR/<sha256><ext>; dedup is automatic via the
    content-addressed name.

    Returns a list of dicts: each carries `path` (absolute str),
    `mime`, `sha256`, `size`, optionally `page_count` (PDFs only) or
    `rejected` (with `filename` for the warn-line render).
    """
    out: list[dict] = []
    atts = getattr(message, 'attachments', None) or []
    if not atts:
        return out
    CHAT_ATTACHMENTS_DIR.mkdir(parents=True, exist_ok=True)
    rejected_names: list[str] = []
    for att in atts:
        mime = (getattr(att, 'content_type', None) or '').split(';')[0].strip()
        size = int(getattr(att, 'size', 0) or 0)
        filename = getattr(att, 'filename', None) or '?'
        # Mime gate first — silently drop non-relayable types.
        if not (mime.startswith('image/') or mime == 'application/pdf'):
            continue
        if size > CHAT_ATTACHMENT_SIZE_LIMIT:
            out.append({
                'rejected': 'too_large',
                'filename': filename,
                'mime': mime,
                'size': size,
            })
            rejected_names.append(filename)
            continue
        try:
            data = await att.read()
        except Exception as exc:  # noqa: BLE001 — log + skip; never crash on_message
            _log(f'_ingest_attachments: read failed for {filename}: {exc}')
            continue
        sha = hashlib.sha256(data).hexdigest()
        ext = _attachment_ext(att, mime)
        cached = CHAT_ATTACHMENTS_DIR / (sha + ext)
        if not cached.exists():
            tmp = cached.with_suffix(cached.suffix + '.tmp')
            tmp.write_bytes(data)
            os.replace(tmp, cached)
        entry: dict = {
            'path': str(cached),
            'mime': mime,
            'sha256': sha,
            'size': len(data),
            'filename': filename,
        }
        if mime == 'application/pdf':
            entry['page_count'] = _probe_pdf_page_count(data)
        out.append(entry)
    # Surface rejections to the user inline so they know the chat-relay
    # body still landed but the file did not. Best-effort: if the reply
    # fails, the rejected entry in the buffer is the fallback breadcrumb.
    if rejected_names:
        try:
            warn = (
                '⚠️ attachment(s) over '
                f'{CHAT_ATTACHMENT_SIZE_LIMIT // (1024 * 1024)}MB '
                f'were not relayed: {", ".join(rejected_names)}'
            )
            await message.reply(warn)
        except Exception as exc:  # noqa: BLE001 — non-fatal
            _log(f'_ingest_attachments: warn reply failed: {exc}')
    return out


def append_chat_buffer(
    recipient: str,
    body: str,
    attachments: list[dict] | None = None,
) -> int:
    """Append a message for `recipient` to the buffer. Returns the new
    per-recipient count (the N for the `N new bridget messages` nudge).

    `attachments`, when supplied, is a list of dicts as returned by
    _ingest_attachments — each carries path/mime/sha256/size, optionally
    page_count for PDFs and rejected for size-cap violations. The list
    is persisted alongside ts/body; old entries without an attachments
    key default to an empty list at format time (ds-ff7c)."""
    def _do(buf):
        msgs = buf.setdefault(recipient, [])
        ts = datetime.datetime.now(datetime.timezone.utc).strftime(
            '%Y-%m-%dT%H:%M:%SZ'
        )
        entry = {'ts': ts, 'body': body}
        if attachments:
            entry['attachments'] = attachments
        msgs.append(entry)
        return len(msgs)
    return _with_chat_buffer_lock(_do)


def drain_chat_buffer(recipient: str) -> list[dict]:
    """Return all queued messages for `recipient` and clear them from disk.

    Empty list when nothing pending — the recipient key is removed from
    the buffer so it doesn't pile up empty entries across drain cycles."""
    def _do(buf):
        return buf.pop(recipient, [])
    return _with_chat_buffer_lock(_do)


def _chat_entry_age_sec(entry: dict, now: datetime.datetime) -> float:
    """Seconds since `entry` was buffered. Unparseable/missing ts → inf, so
    a malformed entry ages out rather than being pinned on disk forever."""
    ts = entry.get('ts')
    if not isinstance(ts, str):
        return float('inf')
    try:
        parsed = datetime.datetime.strptime(ts, '%Y-%m-%dT%H:%M:%SZ').replace(
            tzinfo=datetime.timezone.utc
        )
    except ValueError:
        return float('inf')
    return (now - parsed).total_seconds()


def sweep_chat_buffer_deadletters(
    live: set[str],
    max_age_sec: int | None = None,
    now: datetime.datetime | None = None,
) -> list[dict]:
    """Reassign undrainable buffer entries to DEFAULT_ROUTE. Returns them.

    The buffer only empties when the recipient itself runs `bridget chat
    read <name>`, so any entry queued for an agent that is not running is
    unreachable until that agent starts — and for a retired agent, that is
    never (mg-4d10). Entries older than max_age_sec whose recipient is not
    in `live` are moved to mayor's queue, tagged with `orphaned_from` and
    `orphaned_at`, and surface as a dead-letter section on mayor's next
    drain.

    Reassigned, not deleted: these are the user's own words and the whole
    failure being fixed is that they went unanswered. Callers must pass a
    liveness set they actually determined — never call this with an empty
    set that merely means "couldn't reach pogod", or it will orphan
    everything."""
    max_age = (
        CHAT_BUFFER_DEADLETTER_AGE_SEC if max_age_sec is None else max_age_sec
    )
    cutoff_now = now or datetime.datetime.now(datetime.timezone.utc)
    stamp = cutoff_now.strftime('%Y-%m-%dT%H:%M:%SZ')

    def _do(buf):
        moved: list[dict] = []
        for name in sorted(buf):
            if name == DEFAULT_ROUTE or name in live:
                continue
            keep = []
            for entry in buf[name]:
                if _chat_entry_age_sec(entry, cutoff_now) < max_age:
                    keep.append(entry)
                    continue
                orphan = dict(entry)
                orphan['orphaned_from'] = name
                orphan['orphaned_at'] = stamp
                moved.append(orphan)
            if keep:
                buf[name] = keep
            else:
                buf.pop(name, None)
        if moved:
            buf.setdefault(DEFAULT_ROUTE, []).extend(moved)
        return moved

    return _with_chat_buffer_lock(_do)


def format_chat_buffer_drain(agent: str, msgs: list[dict]) -> str:
    """Render the drain output that `bridget chat read <agent>` prints.

    Empty: a one-liner so the agent's caller can distinguish a hit-the-
    bottom drain from a parse error. Non-empty: a count header followed
    by `[ts] body` lines, oldest first (insertion order). Each entry's
    attachments (ds-ff7c) render on indented `  📎 <path> (<mime>,
    <size>B[, <pages>pp])` lines below the body, or `  ⚠️ rejected
    attachment: <name> (<reason>)` for size-cap rejections."""
    if not msgs:
        return f'No new bridget messages for {agent}.'
    plural = '' if len(msgs) == 1 else 's'
    lines = [f'{len(msgs)} new bridget message{plural} for {agent}:', '']
    orphans = [m for m in msgs if m.get('orphaned_from')]
    if orphans:
        n = len(orphans)
        lines.append(
            f'⚠️ {n} DEAD-LETTER message{"" if n == 1 else "s"} below '
            f'(marked ☠️): the user addressed {"it" if n == 1 else "them"} '
            f'to an agent that was not running, so {"it" if n == 1 else "they"} '
            f'sat undelivered. Nobody has answered {"it" if n == 1 else "them"} '
            f'— read, act, and reply to the user directly with '
            f'`bridget chat {agent} "..."` (mg-4d10).'
        )
        lines.append('')
    for m in msgs:
        ts = m.get('ts') or '?'
        body = m.get('body') or ''
        orphaned_from = m.get('orphaned_from')
        if orphaned_from:
            lines.append(
                f'☠️ [{ts}] (dead-letter: was routed to `{orphaned_from}`, '
                f'which never read it) {body}'
            )
        else:
            lines.append(f'[{ts}] {body}')
        for att in m.get('attachments') or []:
            if att.get('rejected'):
                name = att.get('filename') or att.get('path') or '?'
                reason = att.get('rejected') or 'rejected'
                lines.append(f'  ⚠️ rejected attachment: {name} ({reason})')
                continue
            path = att.get('path') or '?'
            mime = att.get('mime') or 'application/octet-stream'
            size = att.get('size')
            size_str = f'{size}B' if isinstance(size, int) else '?B'
            extra = ''
            pages = att.get('page_count')
            if isinstance(pages, int):
                extra = f', {pages}pp'
            lines.append(f'  📎 {path} ({mime}, {size_str}{extra})')
    return '\n'.join(lines)


def _guess_mime_from_ext(path: Path) -> str | None:
    """Map an attachment file's extension to a mime type the relay
    accepts. Returns None for unrelayable types so the CLI can reject
    early instead of letting the daemon silently drop them."""
    ext = path.suffix.lower()
    table = {
        '.png':  'image/png',
        '.jpg':  'image/jpeg',
        '.jpeg': 'image/jpeg',
        '.gif':  'image/gif',
        '.webp': 'image/webp',
        '.bmp':  'image/bmp',
        '.svg':  'image/svg+xml',
        '.tiff': 'image/tiff',
        '.tif':  'image/tiff',
        '.pdf':  'application/pdf',
    }
    return table.get(ext)


def _cache_attachment_for_cli(src: Path) -> Path:
    """sha256+copy `src` into CHAT_ATTACHMENTS_DIR so cache parity holds
    across outbound CLI sends. Returns the cached absolute Path."""
    data = src.read_bytes()
    sha = hashlib.sha256(data).hexdigest()
    ext = src.suffix.lower() or '.bin'
    # Same extension-shape guard as the inbound path: keep cache names
    # short and known-safe even if the source had a weird suffix.
    if not re.fullmatch(r'\.[A-Za-z0-9]{1,8}', ext):
        ext = '.bin'
    CHAT_ATTACHMENTS_DIR.mkdir(parents=True, exist_ok=True)
    cached = CHAT_ATTACHMENTS_DIR / (sha + ext)
    if not cached.exists():
        tmp = cached.with_suffix(cached.suffix + '.tmp')
        tmp.write_bytes(data)
        os.replace(tmp, cached)
    return cached


def _chat_cli_main(argv: list[str]) -> int:
    """Handle the `bridget chat …` CLI verbs.

    Forms:
        bridget chat <agent_name> <body...> [--attach FILE ...]
                                              — agent → user DM (mg-c05a),
                                                with optional image/PDF
                                                attachments (ds-ff7c)
        bridget chat send <agent_name> <body...> [--attach FILE ...]
                                              — `send` is an accepted
                                                synonym verb, symmetric
                                                with `chat read`; behaves
                                                identically to the form
                                                above (mg-ad08)
        bridget chat <body...> [--attach FILE ...]
                                              — no agent arg; sender is
                                                inferred from the
                                                POGO_AGENT_NAME env var
                                                when running in an agent /
                                                polecat context (mg-ad08)
        bridget chat read <agent_name>        — drain user → agent buffer

    `--attach FILE` is repeatable; each file is validated (mime + size)
    at parse time so user errors surface immediately instead of being
    silently dropped on the daemon side. Files are sha256+copied into
    CHAT_ATTACHMENTS_DIR (parity with inbound cache); the cached paths
    are what go in the chat-drop envelope.

    Disambiguation between the explicit and env-inferred forms is by
    positional count: 2+ positionals → explicit `<agent_name> <body...>`
    (backward compatible); exactly 1 positional with POGO_AGENT_NAME set
    → env-inferred sender with the lone positional as the body. Quote a
    multi-word body as a single arg to use the env-inferred form.

    Exit codes: 0 on success, 2 on usage error (missing args / empty
    body / empty agent name / bad --attach). Pure stdlib — must work in
    venvs without discord.py installed.
    """
    if not argv:
        print(
            'bridget: usage: bridget chat [send] <agent_name> <body...> '
            '[--attach FILE ...]\n'
            '         or:    bridget chat <body...>   '
            '(sender from $POGO_AGENT_NAME)\n'
            '         or:    bridget chat read <agent_name>',
            file=sys.stderr,
        )
        return 2
    if argv[0] == 'read':
        return _chat_read_cli_main(argv[1:])
    # `send` is an accepted synonym verb so `bridget chat send <agent>
    # <body>` works identically to `bridget chat <agent> <body>`
    # (symmetric with `chat read`). Without it, a caller who typed
    # `chat send mayor "hi"` would get `send` parsed as the agent name
    # and `mayor hi` as the body (mg-ad08). Strip the verb and fall
    # through to the shared parser.
    if argv[0] == 'send':
        argv = argv[1:]
    # Split positional args from --attach options. --attach takes the
    # next arg as its value, so we walk argv index-by-index rather than
    # a single pass; stops at -- so explicit literal `--` separates body
    # tokens from options if a body word ever starts with `--`.
    positional: list[str] = []
    attaches: list[str] = []
    i = 0
    seen_end = False
    while i < len(argv):
        tok = argv[i]
        if not seen_end and tok == '--attach':
            if i + 1 >= len(argv):
                print(
                    'bridget: --attach needs a FILE argument',
                    file=sys.stderr,
                )
                return 2
            attaches.append(argv[i + 1])
            i += 2
            continue
        if not seen_end and tok == '--':
            seen_end = True
            i += 1
            continue
        positional.append(tok)
        i += 1
    # Resolve sender + body. Two shapes, disambiguated by positional
    # count so the explicit form stays backward compatible (mg-ad08):
    #   2+ positionals → explicit `<agent_name> <body...>`
    #   1 positional + $POGO_AGENT_NAME set → env-inferred sender, the
    #     lone positional is the whole body
    env_sender = (os.environ.get('POGO_AGENT_NAME') or '').strip()
    if len(positional) >= 2:
        agent_name = positional[0].strip()
        body = ' '.join(positional[1:]).strip()
    elif len(positional) == 1 and env_sender:
        agent_name = env_sender
        body = positional[0].strip()
    else:
        print(
            'bridget: usage: bridget chat [send] <agent_name> <body...> '
            '[--attach FILE ...]\n'
            '         or:    bridget chat <body...>   '
            '(sender from $POGO_AGENT_NAME)',
            file=sys.stderr,
        )
        return 2
    if not agent_name:
        print('bridget: chat agent_name cannot be empty', file=sys.stderr)
        return 2
    if not body:
        print('bridget: chat body cannot be empty', file=sys.stderr)
        return 2
    cached_paths: list[Path] = []
    total = 0
    for raw_path in attaches:
        src = Path(raw_path).expanduser().resolve()
        if not src.is_file():
            print(
                f'bridget: --attach: not a file: {raw_path}',
                file=sys.stderr,
            )
            return 2
        mime = _guess_mime_from_ext(src)
        if mime is None:
            print(
                f'bridget: --attach: unsupported file type (image/* + '
                f'application/pdf only): {raw_path}',
                file=sys.stderr,
            )
            return 2
        size = src.stat().st_size
        total += size
        if size > CHAT_ATTACHMENT_SIZE_LIMIT:
            mb = CHAT_ATTACHMENT_SIZE_LIMIT // (1024 * 1024)
            print(
                f'bridget: --attach: {raw_path} is {size} bytes; cap is '
                f'{mb} MiB',
                file=sys.stderr,
            )
            return 2
        cached_paths.append(_cache_attachment_for_cli(src))
    if total > CHAT_ATTACHMENT_SIZE_LIMIT:
        mb = CHAT_ATTACHMENT_SIZE_LIMIT // (1024 * 1024)
        print(
            f'bridget: --attach total size {total} bytes exceeds the '
            f'{mb} MiB cap',
            file=sys.stderr,
        )
        return 2
    write_chat_drop(agent_name, body, attachments=cached_paths or None)
    return 0


def _chat_read_cli_main(argv: list[str]) -> int:
    """Drain the chat-relay buffer for `<agent_name>` and print contents.

    Always exits 0 when the agent name is valid — an empty buffer is a
    normal result, not an error. The caller (typically an agent reacting
    to a `N new bridget messages` nudge) reads stdout and dispatches the
    messages from there.
    """
    if len(argv) < 1:
        print(
            'bridget: usage: bridget chat read <agent_name>',
            file=sys.stderr,
        )
        return 2
    agent_name = argv[0].strip()
    if not agent_name:
        print(
            'bridget: chat read agent_name cannot be empty',
            file=sys.stderr,
        )
        return 2
    # mg-4d10: before mayor drains, adopt any entry that has been sitting
    # in a non-running agent's queue past the dead-letter age. Nothing
    # else in the system ever revisits those entries — the queue only
    # empties when its own recipient runs this command, which a stopped
    # or retired agent never does. Only sweep when liveness is actually
    # known: `None` means pogod was unreachable, and treating that as
    # "nothing is running" would orphan live agents' pending mail.
    if agent_name == DEFAULT_ROUTE:
        live = discover_running_agents()
        if live is not None:
            sweep_chat_buffer_deadletters(live | {agent_name})
    msgs = drain_chat_buffer(agent_name)
    # ia-5f66: stamp mayor's last-poll timestamp so the Inject API can
    # detect mayor-down (returns 503 if no read in INJECT_MAYOR_DOWN_SEC).
    # Only mayor's reads count — other agents have their own perception
    # paths that the Inject API doesn't gate on.
    if agent_name == 'mayor':
        try:
            ts = datetime.datetime.now(datetime.timezone.utc).strftime(
                '%Y-%m-%dT%H:%M:%SZ'
            )
            (HOME / '.pogo' / 'bridget.last-poll').write_text(ts + '\n')
        except OSError:
            pass  # non-fatal; absent marker = always-200 path
    print(format_chat_buffer_drain(agent_name, msgs))
    return 0


