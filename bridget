async def watch_task_transitions(user: discord.User):
    states, file_existed = load_task_states()
    primed = file_existed  # if cache file existed, treat first tick as a normal diff
    while not client.is_closed():
        try:
            rc, out, err = run_mg(['list', '--json', '--all'])
            if rc != 0:
                print(f'watch_task_transitions mg list failed: {err.strip()[:200]}', file=sys.stderr)
                await asyncio.sleep(POLL_INTERVAL)
                continue

            seen_ids = set()
            transitions = []
            for line in out.splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    task = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if task.get('type') != 'task':
                    continue
                tid = task.get('id')
                status = task.get('status')
                if not tid or not status:
                    continue
                seen_ids.add(tid)
                prev = states.get(tid)
                if primed and prev != status and status in _TRANSITION_FORMATS:
                    msg = format_transition(task, status)
                    if msg:
                        transitions.append(msg)
                states[tid] = status

            for stale in set(states.keys()) - seen_ids:
                del states[stale]

            if not primed:
                primed = True
            else:
                for msg in transitions:
                    try:
                        await user.send(msg)
                    except discord.HTTPException as e:
                        print(f'task-transition send failed: {e}', file=sys.stderr)

            save_task_states(states)
        except Exception as e:
            print(f'watch_task_transitions loop error: {e}', file=sys.stderr)
        await asyncio.sleep(POLL_INTERVAL)


def run_mg(args: list[str]) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            [MG_BIN, *args],
            capture_output=True, text=True, timeout=30,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, '', 'mg command timed out'
    except FileNotFoundError:
        return 127, '', f'mg not found at {MG_BIN}'


def route_recipient(mg_id: str) -> str:
    """Mailbox for a human reply to mg_id. type=report → director; else architect."""
    rc, out, err = run_mg(['show', mg_id])
    if rc != 0:
        print(
            f'route_recipient: mg show {mg_id} failed (rc={rc}); '
            f'falling back to architect. err={err.strip()[:200]}',
            file=sys.stderr,
        )
        return 'architect'
    m = re.search(r'^Type:\s+(\S+)', out, re.MULTILINE)
    if not m:
        print(
            f'route_recipient: no Type: line in mg show {mg_id}; '
            f'falling back to architect.',
            file=sys.stderr,
        )
        return 'architect'
    return 'director' if m.group(1).strip() == 'report' else 'architect'


def run_pogo(args: list[str]) -> tuple[int, str, str]:
    pogo_bin = CONFIG.get('pogo_bin') or shutil.which('pogo')
    if not pogo_bin:
        return 1, '', 'pogo binary not found (install pogo or set POGO_BIN)'
    try:
        r = subprocess.run(
            [pogo_bin, *args],
            capture_output=True, text=True, timeout=30,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, '', 'pogo command timed out'


def run_shell(args: list[str], timeout: int = 30, cwd=None) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            args, capture_output=True, text=True, timeout=timeout, cwd=cwd,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, '', f'command timed out: {args[0] if args else "?"}'
    except FileNotFoundError:
        return 127, '', f'command not found: {args[0] if args else "?"}'


FRONTMATTER_RE = re.compile(r'\A---\s*\n.*?\n---\s*\n', re.DOTALL)
FRONTMATTER_STATUS_RE = re.compile(r'^status:\s*(\S+)', re.MULTILINE)


def read_design_status(mg_id: str) -> str | None:
    """Return the frontmatter status field for a design, or None."""
    path = DESIGNS_DIR / f'{mg_id}.md'
    try:
        text = path.read_text()
    except (FileNotFoundError, NotADirectoryError, PermissionError, OSError):
        return None
    m = FRONTMATTER_RE.match(text)
    if not m:
        return None
    fm = m.group(0)
    sm = FRONTMATTER_STATUS_RE.search(fm)
    return sm.group(1) if sm else None


def read_design_doc(mg_id: str) -> str | None:
    """Return the design doc body for mg_id with YAML frontmatter stripped.

    Returns None if the file is missing or unreadable. Designs that lack
    frontmatter are returned verbatim.
    """
    path = DESIGNS_DIR / f'{mg_id}.md'
    try:
        text = path.read_text()
    except (FileNotFoundError, NotADirectoryError, PermissionError, OSError):
        return None
    return FRONTMATTER_RE.sub('', text, count=1).lstrip('\n')


def chunk_for_discord(text: str, limit: int = 1700, max_chunks: int = 3) -> list[str]:
    """Split text for Discord's per-message budget.

    Prefers `\\n## ` section boundaries; falls back to hard splits at `limit`
    when a single section exceeds the budget. If max_chunks is exceeded,
    drops the rest and appends a truncation footer to the last emitted chunk.
    """
    if not text:
        return ['']
    sections: list[str] = []
    if '\n## ' in text:
        first, _, rest = text.partition('\n## ')
        sections.append(first)
        for part in rest.split('\n## '):
            sections.append('## ' + part)
    else:
        sections = [text]

    chunks: list[str] = []
    cur = ''
    for sec in sections:
        if len(sec) > limit:
            if cur:
                chunks.append(cur)
                cur = ''
            for i in range(0, len(sec), limit):
                chunks.append(sec[i:i + limit])
            continue
        candidate = sec if not cur else f'{cur}\n{sec}'
        if len(candidate) <= limit:
            cur = candidate
        else:
            if cur:
                chunks.append(cur)
            cur = sec
    if cur:
        chunks.append(cur)

    if len(chunks) > max_chunks:
        kept = chunks[:max_chunks]
        kept[-1] = (
            kept[-1].rstrip()
            + f'\n…[truncated; full doc at {DESIGNS_DIR}]'
        )
        return kept
    return chunks


def find_mails_for(mg_id: str) -> list:
    """Return [(path, mail_dict, dir_name)] for mails referencing mg_id, newest first."""
    out = []
    needle = mg_id.lower()
    for d in ('new', 'cur'):
        ddir = MAIL_DIR.parent / d
        if not ddir.exists():
            continue
        for p in sorted(ddir.iterdir(), reverse=True):
            try:
                content = p.read_text()
                if needle in content.lower():
                    out.append((p, parse_mail(content), d))
            except Exception:
                pass
    return out


# Subject-line prefixes for mails that require an explicit action verb
# (approve / reject / revise / explain) to be marked read. `dismiss` and
# `dismiss all` skip mails whose Subject matches one of these prefixes.
# Add new prefixes here as more action-required workflows ship.
PROTECTED_SUBJECT_PREFIXES = (
    'Report ready:',     # director → human, awaiting approve/reject/revise
    'approval needed',   # architect → human, awaiting approve/reject/revise
)


def _mail_subject(content: str) -> str:
    """First Subject: header from a mail file, or '' if absent."""
    for line in content.splitlines():
        if line == '':
            return ''
        if line.startswith('Subject: '):
            return line[len('Subject: '):]
    return ''


def mark_mail_read(mg_id=None, all_unread: bool = False,
                   protect_actionable: bool = False) -> int:
    """Move mails from human/new/ → human/cur/. If mg_id is set, only mails
    whose subject/body references that id; if all_unread is True, every mail.
    When protect_actionable is True, mails whose Subject begins with any
    PROTECTED_SUBJECT_PREFIXES entry are skipped (left in new/).
    Returns the count actually moved."""
    if not MAIL_DIR.exists():
        return 0
    cur_dir = MAIL_DIR.parent / 'cur'
    cur_dir.mkdir(parents=True, exist_ok=True)
    n = 0
    for p in sorted(MAIL_DIR.iterdir()):
        try:
            if all_unread:
                if protect_actionable:
                    subj = _mail_subject(p.read_text())
                    if any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES):
                        continue
                p.rename(cur_dir / p.name)
                n += 1
                continue
            if mg_id is None:
                continue
            content = p.read_text()
            # Match the mg-id case-insensitively; covers headers and body.
            if mg_id.lower() in content.lower():
                if protect_actionable:
                    subj = _mail_subject(content)
                    if any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES):
                        continue
                p.rename(cur_dir / p.name)
                n += 1
        except Exception as e:
            print(f"mark_mail_read error on {p.name}: {e}", file=sys.stderr)
    return n


# Statuses indicating an mg work item is no longer actionable: surfacing
# its Report-ready / approval-needed mail in inbox would be stale noise.
_CLOSED_MG_STATUSES = frozenset({'shelved', 'done', 'archived'})


def _mg_item_closed(mg_id: str) -> bool:
    """True iff `mg show mg_id` reports a closed status (shelved/done/archived).

    Defensive: any failure (rc!=0, no Status: line, unexpected output) returns
    False so the caller surfaces the mail — false positive is preferable to
    false negative for inbox visibility.
    """
    rc, out, _ = run_mg(['show', mg_id])
    if rc != 0:
        return False
    m = re.search(r'^Status:\s+(\S+)', out, re.MULTILINE)
    if not m:
        return False
    return m.group(1) in _CLOSED_MG_STATUSES


def scan_pending_approvals() -> list[str]:
    """Subjects of unread mails in human/new/ that are approval requests.

    Skips mails whose mg-id is shelved/done/archived — those approvals are
    no longer actionable (item was routed elsewhere before human acted).
    """
    if not MAIL_DIR.exists():
        return []
    out = []
    for p in sorted(MAIL_DIR.iterdir()):
        try:
            for line in p.read_text().splitlines():
                if line == '':
                    break
                if line.startswith('Subject: approval needed '):
                    subj = line[len('Subject: '):]
                    m = re.search(r'mg-[0-9a-f]+', subj)
                    if m and _mg_item_closed(m.group(0)):
                        break
                    out.append(subj)
                    break
        except Exception:
            pass
    return out


def scan_pending_reports() -> list[str]:
    """Subjects of unread mails in human/new/ that are director Reports.

    Skips mails whose mg-id is shelved/done/archived — those Reports are
    stale (work item was closed before the human acted on the Report).
    """
    if not MAIL_DIR.exists():
        return []
    out = []
    for p in sorted(MAIL_DIR.iterdir()):
        try:
            for line in p.read_text().splitlines():
                if line == '':
                    break
                if line.startswith('Subject: Report ready:'):
                    subj = line[len('Subject: '):]
                    m = re.search(r'mg-[0-9a-f]+', subj)
                    if m and _mg_item_closed(m.group(0)):
                        break
                    out.append(subj)
                    break
        except Exception:
            pass
    return out


def get_inbox_summary() -> str:
    """Decide queue: unread mail, pending approvals, pending Reports."""
    parts = []

    unread = sorted(MAIL_DIR.iterdir()) if MAIL_DIR.exists() else []
    parts.append(f"📬 Unread mail to human: **{len(unread)}**")

    if unread:
        for i, p in enumerate(unread, start=1):
            try:
                mail = parse_mail(p.read_text())
                haystack = (mail['subject'] + ' ' + mail['body']).lower()
                ids = sorted(set(re.findall(r'mg-[0-9a-f]+', haystack)))
                id_str = ', '.join(ids) if ids else '(no mg-id)'
                subj = mail['subject'][:60]
                parts.append(f'  • [m{i} / {id_str}] {mail["from"]}: {subj}')
            except Exception:
                parts.append(f'  • [m{i}] (parse error: {p.name})')

    approvals = scan_pending_approvals()
    if approvals:
        parts.append("\n**Pending approvals:**")
        for s in approvals:
            parts.append(f"• {s}")

    reports = scan_pending_reports()
    if reports:
        parts.append("\n**Pending reports:**")
        for s in reports:
            parts.append(f"• {s}")

    return '\n'.join(parts)


# Order in which status sections render; empty buckets are omitted.
STATUS_SECTION_ORDER = ('Projects', 'Reports', 'Designs', 'Bugs', 'Tasks', 'Other')

# Tags that mark a Type=idea as a Project in any lifecycle state. Items
# with any of these tags are Project-roots, not ordinary designs.
_PROJECT_TAGS = frozenset({
    # canonical 5-state vocab (target end-state)
    'scheduled', 'ready-for-kickoff', 'in-progress',
    'done', 'cancelled',
    # current mayor-flow lifecycle tags
    'kickoff-pending', 'kickoff-done', 'roadmap-drafted',
    'handed-off-to-mayor', 'staged',
})

# Tags that mark a Project as actually running right now. Accept both
# canonical 'in-progress' and mayor's current 'kickoff-done' until the
# director-rewrite cascade standardizes on 'in-progress'.
_IN_PROGRESS_TAGS = frozenset({'in-progress', 'kickoff-done'})

# mg item-type → status section. Anything not listed falls into "Other".
_TYPE_TO_SECTION = {
    'report': 'Reports',
    'idea':   'Designs',
    'bug':    'Bugs',
    'task':   'Tasks',
}

def categorize_in_flight(items: list[dict]) -> dict[str, list[dict]]:
    """Bucket in-flight items by type. Unknown types fall into 'Other'.

    Type=idea items with any _PROJECT_TAGS tag are Project-roots. If
    they also carry an _IN_PROGRESS_TAGS tag they bucket into 'Projects';
    otherwise they're hidden entirely — they're not in flight and live
    on the Product Roadmap, not the status view.

    Type=report items tagged 'approved' are filtered out — they've been
    scheduled into a Project, and the Project entry takes over visibility.
    """
    buckets: dict[str, list[dict]] = {s: [] for s in STATUS_SECTION_ORDER}
    for item in items:
        tags = set(item.get('tags') or [])
        item_type = item.get('type')
        if item_type == 'report' and 'approved' in tags:
            continue
        if item_type == 'idea' and _PROJECT_TAGS & tags:
            if _IN_PROGRESS_TAGS & tags:
                buckets['Projects'].append(item)
            continue  # Project but not in-flight: lives on Product Roadmap
        section = _TYPE_TO_SECTION.get(item_type, 'Other')
        buckets[section].append(item)
    return buckets


def derive_review_label(item: dict) -> str:
    """For report items with an unread Report-ready mail in human/new/,
    return 'review'. Otherwise return the item's mg status verbatim."""
    status = item.get('status', '?')
    if item.get('type') != 'report':
        return status
    iid = (item.get('id') or '').lower()
    if not iid or not MAIL_DIR.exists():
        return status
    needle = f'subject: report ready: {iid}'
    for p in MAIL_DIR.iterdir():
        try:
            for line in p.read_text().splitlines():
                if line == '':
                    break
                if line.lower().startswith(needle):
                    return 'review'
        except Exception:
            pass
    return status


def get_status_summary() -> str:
    """In-flight work, categorized by type (Reports / Designs / Bugs / Tasks)."""
    rc, out, err = run_mg(['list', '--json'])
    in_flight: list[dict] = []
    mg_error = None
    if rc == 0:
        for line in out.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
                if d.get('status') in ('available', 'claimed', 'pending'):
                    in_flight.append(d)
            except json.JSONDecodeError:
                pass
    elif err:
        mg_error = err.strip()[:200]

    buckets = categorize_in_flight(in_flight)

    parts = []
    for section in STATUS_SECTION_ORDER:
        items = buckets[section]
        if not items:
            continue
        if parts:
            parts.append('')
        parts.append(f"**{section}**")
        for d in items:
            iid = d.get('id', '?')
            label = derive_review_label(d)
            title = (d.get('title') or '?')[:80]
            parts.append(f"[{iid}] {label}: {title}")

    if not parts:
        out_str = "No work in flight."
    else:
        out_str = '\n'.join(parts)

    if mg_error:
        out_str = out_str + f"\n\n(mg list error: {mg_error})"
    return out_str


def handle_command(text: str) -> str | list[str]:
    text = text.strip()
    low = text.lower()

    if low.startswith('approve mg-') or low.startswith('approve dr-'):
        parts = text.split(None, 1)
        mg_id = parts[1] if len(parts) > 1 else ''
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=approve {mg_id}',
            '--body=approved via discord',
        ])
        if rc == 0:
            n = mark_mail_read(mg_id=mg_id)
            tail = f" (cleared {n} related mail{'s' if n != 1 else ''})" if n else ''
            return f"✓ approve sent: `{mg_id}`{tail}"
        return f"✗ failed: {err or out}"

    if low.startswith('reject mg-') or low.startswith('reject dr-'):
        parts = text.split(None, 2)
        if len(parts) < 2:
            return "Usage: `reject mg-XXXX <reason>` (or `dr-XXXX`)"
        mg_id = parts[1]
        reason = parts[2] if len(parts) > 2 else 'rejected via discord'
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=reject {mg_id}',
            f'--body={reason}',
        ])
        if rc == 0:
            n = mark_mail_read(mg_id=mg_id)
            tail = f" (cleared {n} related mail{'s' if n != 1 else ''})" if n else ''
            return f"✓ reject sent: `{mg_id}`{tail}"
        return f"✗ failed: {err or out}"

    if low.startswith('revise mg-') or low.startswith('revise dr-'):
        parts = text.split(None, 2)
        if len(parts) < 3:
            return "Usage: `revise mg-XXXX <feedback>` (or `dr-XXXX`)"
        mg_id = parts[1]
        feedback = parts[2]
        sh_rc, sh_out, _ = run_mg(['show', mg_id])
        if sh_rc == 0 and re.search(r'^Status:\s+shelved', sh_out, re.MULTILINE):
            run_mg(['unshelve', mg_id])
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=revise {mg_id}',
            f'--body={feedback}',
        ])
        if rc == 0:
            n = mark_mail_read(mg_id=mg_id)
            tail = f" (cleared {n} related mail{'s' if n != 1 else ''})" if n else ''
            return f"✓ revise sent: `{mg_id}`{tail}"
        return f"✗ failed: {err or out}"

    m_index_match = re.match(r'^read\s+m(\d+)$', low)
    if m_index_match:
        n = int(m_index_match.group(1))
        unread = sorted(MAIL_DIR.iterdir()) if MAIL_DIR.exists() else []
        if n < 1 or n > len(unread):
            return (
                f"m{n} not found — inbox has {len(unread)} unread mail"
                f"{'s' if len(unread) != 1 else ''}. Run `inbox` to refresh."
            )
        p = unread[n - 1]
        try:
            mail = parse_mail(p.read_text())
        except Exception as e:
            return f"✗ failed to read m{n}: {e}"
        haystack = (mail['subject'] + ' ' + mail['body']).lower()
        ids = re.findall(r'mg-[0-9a-f]+', haystack)
        if ids:
            return handle_command(f'read {ids[0]}')
        subj = mail.get('subject', '')
        protected = any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES)
        state = 'unread (action required)' if protected else 'unread'
        if not protected:
            cur_dir = MAIL_DIR.parent / 'cur'
            cur_dir.mkdir(parents=True, exist_ok=True)
            try:
                p.rename(cur_dir / p.name)
            except Exception as e:
                print(f'auto-mark-read failed for {p.name}: {e}', file=sys.stderr)
        log_mail_action('read', mg_id=None)
        return (
            f"📧 from `{mail['from']}` _({state})_\n"
            f"**{mail['subject']}**\n\n"
            f"{mail['body']}"
        )

    if low.startswith('read mg-') or low.startswith('read dr-'):
        parts = text.split(None, 1)
        if len(parts) < 2:
            return "Usage: `read mg-XXXX` (or `dr-XXXX`)"
        mg_id = parts[1].strip()

        matches = find_mails_for(mg_id)
        mail_footer = ''
        if matches:
            p, mail, dir_name = matches[0]
            subj = mail.get('subject', '')
            protected = any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES)
            if dir_name == 'new':
                state = 'unread (action required)' if protected else 'unread'
            else:
                state = 'read'
            mail_footer = (
                f"📧 latest mail: **{mail['subject']}** _({state})_"
            )
            if dir_name == 'new' and not protected:
                cur_dir = MAIL_DIR.parent / 'cur'
                cur_dir.mkdir(parents=True, exist_ok=True)
                try:
                    p.rename(cur_dir / p.name)
                    log_mail_action('read', mg_id=mg_id)
                except Exception as e:
                    print(f'auto-mark-read failed for {p.name}: {e}', file=sys.stderr)

        design_body = read_design_doc(mg_id)
        if design_body is not None:
            status = read_design_status(mg_id) or 'unknown'
            header = f"📐 **Design `{mg_id}`** _({status})_"
            footer = f"\n\n---\n{mail_footer}" if mail_footer else ''
            full = f"{header}\n{design_body.rstrip()}{footer}"
            return chunk_for_discord(full)

        if not matches:
            return f"No mail found for `{mg_id}`."
        rest = len(matches) - 1
        rest_note = f"\n\n_({rest} other mail{'s' if rest != 1 else ''} also reference this id; this is the newest.)_" if rest else ''
        return (
            f"📧 from `{mail['from']}` _({state})_\n"
            f"**{mail['subject']}**\n\n"
            f"{mail['body']}"
            f"{rest_note}"
        )

    if low.startswith('dismiss '):
        parts = text.split(None, 1)
        if len(parts) < 2:
            return "Usage: `dismiss mg-XXXX` (or `dr-XXXX`) or `dismiss all`"
        arg = parts[1].strip()
        if arg.lower() == 'all':
            n = mark_mail_read(all_unread=True, protect_actionable=True)
            log_mail_action('dismiss-all')
            return f"✓ marked {n} mail{'s' if n != 1 else ''} read (inbox-zero)"
        if arg.lower().startswith('mg-') or arg.lower().startswith('dr-'):
            n = mark_mail_read(mg_id=arg, protect_actionable=True)
            log_mail_action('dismiss', mg_id=arg)
            return f"✓ marked {n} mail{'s' if n != 1 else ''} read for `{arg}`"
        return "Usage: `dismiss mg-XXXX` (or `dr-XXXX`) or `dismiss all`"

    if low.startswith('explain mg-') or low.startswith('explain dr-'):
        parts = text.split(None, 2)
        if len(parts) < 3:
            return "Usage: `explain mg-XXXX <what to explain>` (or `dr-XXXX`)"
        mg_id = parts[1]
        topic = parts[2]
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=explain {mg_id}',
            f'--body={topic}',
        ])
        return f"✓ explain request sent: `{mg_id}`" if rc == 0 else f"✗ failed: {err or out}"

    if low == 'agents' or low == 'agent list' or low == 'crew':
        rc, out, err = run_pogo(['agent', 'list', '--json'])
        if rc != 0:
            return f'✗ pogo agent list failed: {err or out}'
        try:
            agents_list = json.loads(out)
        except json.JSONDecodeError as e:
            return f'✗ failed to parse agent list: {e}'
        if not agents_list:
            return '🤖 No crew agents registered.'
        lines = [f'🤖 **Crew agents ({len(agents_list)}):**']
        claims_by_assignee = fetch_mg_claims_by_assignee()
        for a in agents_list:
            name = a.get('name', '?')
            emoji, label, badge = agent_state(name, a, claims_by_assignee)
            cycle = agent_cycle_paren(name) if label != 'offline' else ''
            badge_str = f' — {badge}' if badge else ''
            lines.append(
                f'  • {emoji} {label:<7} {name:<12}{badge_str}  {cycle}'.rstrip()
            )
        return '\n'.join(lines)

    if low.startswith('nudge '):
        parts = text.split(None, 2)
        if len(parts) < 2:
            return 'Usage: nudge <agent-name> [reason]'
        agent_name = parts[1]
        reason = parts[2] if len(parts) > 2 else 'status check'
        rc, out, err = run_pogo(['nudge', agent_name, reason])
        if rc != 0:
            return f'✗ nudge failed: {err or out}'
        success = f'✓ nudged {agent_name}: "{reason}"'
        rc2, dout, _ = run_pogo(['agent', 'diagnose', agent_name, '--json'])
        if rc2 != 0:
            return success
        try:
            diag = json.loads(dout)
        except json.JSONDecodeError:
            return success
        tail = strip_ansi(diag.get('recent_output_tail') or '')
        if CREDIT_BALANCE_RE.search(tail):
            return (
                f'⚠️ nudged {agent_name} — but credit balance error in '
                f'recent tail; nudge will likely be ignored. '
                f'Refuel at console.anthropic.com.'
            )
        return success

    if low == 'restart':
        rc, out, err = run_shell(
            ['git', '-C', str(BRIDGET_REPO), 'pull', '--ff-only'], timeout=30,
        )
        if rc != 0:
            return f'❌ git pull failed: {(err or out).strip()[:200]}; staying on old code.'
        rc_sha, sha_out, _ = run_shell(
            ['git', '-C', str(BRIDGET_REPO), 'rev-parse', '--short', 'HEAD'], timeout=10,
        )
        sha = sha_out.strip() if rc_sha == 0 else '?'
        rc_b, _, err_b = run_shell(
            ['bash', 'build.sh'], timeout=10, cwd=str(BRIDGET_REPO),
        )
        if rc_b != 0:
            return f'❌ syntax check failed: {err_b.strip()[:200]}; staying on old code.'
        # 2s gives the Discord ack time to flush before launchd respawns us.
        client.loop.call_later(2.0, lambda: os._exit(0))
        return f'✅ pulled {sha}; restarting in 2s'

    if low == 'mail' or low.startswith('mail '):
        rest = text[len('mail'):].lstrip()
        if '\n' in rest:
            subject, body = rest.split('\n', 1)
            subject = subject.strip()
            body = body.rstrip()
        else:
            subject = rest.strip()
            body = '(no body)'
        if not subject:
            return 'Usage: mail <subject>\n[optional body, multi-line OK]'
        recipient = CONFIG['mail_recipient']
        rc, out, err = run_mg([
            'mail', 'send', recipient,
            '--from=human',
            f'--subject={subject}',
            f'--body={body}',
        ])
        if rc == 0:
            return f'✓ mailed {recipient}: "{subject[:60]}"'
        return f'✗ mail failed: {(err or out).strip()[:200]}'

    if low in ('help', '?', 'commands'):
        lines = ['**Commands:**']
        for c in COMMANDS:
            lines.append(f"• `{c['signature']}`")
        lines.append('')
        lines.append('Type `help <command>` for details on any one.')
        return '\n'.join(lines)
    if low.startswith('help '):
        name = text.split(None, 1)[1].strip().lower()
        c = COMMANDS_BY_NAME.get(name)
        if not c:
            return f"Unknown command `{name}`; type `help` for the menu."
        return f"**`{c['signature']}`**\n\n{c['description']}"

    if low.startswith('idea:'):
        body = text[5:].strip()
        if not body:
            return "Usage: `idea: [optional-tag] [optional-tag] ... <description>`"
        extra_tags = []
        while True:
            m = re.match(r'^\[([^\]]+)\]\s*(.*)$', body, re.DOTALL)
            if not m:
                break
            extra_tags.append(m.group(1).strip())
            body = m.group(2).strip()
        if not body:
            return "Usage: `idea: [optional-tag] [optional-tag] ... <description>`"
        title = body.splitlines()[0][:60]
        args = [
            'new', '--type=idea',
            f'--title={title}',
            f'--body={body}',
            '--assignee=architect',
            '--tag=pogo-inbox',
            f'--repo={INBOX_REPO}',
        ]
        for t in extra_tags:
            args.append(f'--tag={t}')
        rc, out, err = run_mg(args)
        return f"✓ idea filed:\n```\n{out.strip()}\n```" if rc == 0 else f"✗ failed: {err or out}"

    if low.startswith('bug:'):
        body = text[4:].strip()
        if not body:
            return "Usage: `bug: [optional-tag] [optional-tag] ... <description>`"
        extra_tags = []
        while True:
            m = re.match(r'^\[([^\]]+)\]\s*(.*)$', body, re.DOTALL)
            if not m:
                break
            extra_tags.append(m.group(1).strip())
            body = m.group(2).strip()
        if not body:
            return "Usage: `bug: [optional-tag] [optional-tag] ... <description>`"
        is_critical = any(t.lower() == 'critical' for t in extra_tags)
        assignee = 'mayor' if is_critical else 'architect'
        title = body.splitlines()[0][:60]
        args = [
            'new', '--type=bug',
            f'--title={title}',
            f'--body={body}',
            f'--assignee={assignee}',
            '--tag=pogo-inbox',
            f'--repo={INBOX_REPO}',
        ]
        for t in extra_tags:
            args.append(f'--tag={t}')
        rc, out, err = run_mg(args)
        if rc != 0:
            return f"✗ failed: {err or out}"
        if is_critical:
            return f"✓ critical bug filed (routed to mayor):\n```\n{out.strip()}\n```"
        return f"✓ bug filed:\n```\n{out.strip()}\n```"

    if low == 'quiet' or low.startswith('quiet '):
        rest = text.split()[1:]
        if not rest or (len(rest) == 1 and rest[0].lower() == 'status'):
            state = load_quiet()
            if state['enabled']:
                return f"🌙 quiet hours: enabled, {state['start']}–{state['end']} (local)."
            return f"quiet hours: disabled. (window {state['start']}–{state['end']})"
        if len(rest) == 2 and TIME_RE.match(rest[0]) and TIME_RE.match(rest[1]):
            return "Usage: `quiet <true|false> [HH:MM HH:MM]`"
        flag = rest[0].lower()
        if flag not in ('true', 'false'):
            return "Usage: `quiet <true|false> [HH:MM HH:MM]`"
        state = load_quiet()
        times = rest[1:]
        if times:
            if len(times) != 2 or not TIME_RE.match(times[0]) or not TIME_RE.match(times[1]):
                return "Usage: `quiet <true|false> [HH:MM HH:MM]` (times must match HH:MM)"
            state['start'] = times[0]
            state['end'] = times[1]
        if flag == 'true':
            state['enabled'] = True
            save_quiet(state)
            return f"✓ quiet hours: enabled, {state['start']}–{state['end']} (local)."
        state['enabled'] = False
        save_quiet(state)
        return f"✓ quiet hours: disabled. (window {state['start']}–{state['end']} preserved for next enable)"

    if low == 'preapprove' or low.startswith('preapprove '):
        rest = [t.lower() for t in text.split()[1:]]
        if not rest:
            state = load_preapproval()
            if state['enabled']:
                fast_word = 'on' if state['fast'] else 'off'
                return f"🟢 pre-approval: enabled (fast: {fast_word})."
            return "pre-approval: disabled."
        usage = "Usage: `preapprove [true [fast] | false]`"
        if rest[0] not in ('true', 'false'):
            return usage
        if rest[0] == 'true':
            if len(rest) == 1:
                fast = False
            elif len(rest) == 2 and rest[1] == 'fast':
                fast = True
            else:
                return usage
            save_preapproval({'enabled': True, 'fast': fast})
            fast_word = 'on' if fast else 'off'
            return f"✓ pre-approval: enabled (fast: {fast_word})."
        # rest[0] == 'false'
        if len(rest) != 1:
            return usage
        save_preapproval({'enabled': False, 'fast': False})
        return "✓ pre-approval: disabled."

    if low == 'inbox' or low.startswith('inbox '):
        summary = get_inbox_summary()
        if len(summary) > STATUS_OUTPUT_BUDGET:
            summary = summary[:STATUS_OUTPUT_BUDGET] + '\n…(truncated)'
        return summary

    if low == 'status' or low.startswith('status'):
        summary = get_status_summary()
        if len(summary) > STATUS_OUTPUT_BUDGET:
            summary = summary[:STATUS_OUTPUT_BUDGET] + '\n…(truncated)'
        try:
            run_pogo(['nudge', 'crew-mayor', 'status check from human via bridge'])
        except Exception as e:
            print(f'mayor nudge failed: {e}', file=sys.stderr)
        return summary

    return (
        "Unrecognized. Send `help` for the full command list."
    )


@client.event
async def on_ready():
    global _watchers_started
    print(f"logged in as {client.user} (id={client.user.id})", flush=True)
    if _watchers_started:
        print("on_ready re-fired (reconnect); watchers already running", flush=True)
        return
    try:
        user = await client.fetch_user(USER_ID)
    except discord.NotFound:
        print(f"user {USER_ID} not found", file=sys.stderr)
        await client.close()
        return
    client.loop.create_task(watch_mailbox(user))
    client.loop.create_task(watch_task_transitions(user))
    client.loop.create_task(watch_idea_claims(user))
    _watchers_started = True


@client.event
async def on_message(message: discord.Message):
    if message.author.bot:
        return
    if message.author.id != USER_ID:
        return
    if not isinstance(message.channel, discord.DMChannel):
        return
    reply = handle_command(message.content)
    chunks = reply if isinstance(reply, list) else [reply]
    try:
        for i, chunk in enumerate(chunks):
            if len(chunk) > DISCORD_MSG_LIMIT:
                chunk = chunk[:DISCORD_MSG_LIMIT] + '…'
            if i > 0:
                await asyncio.sleep(0.1)
            await message.channel.send(chunk)
    except discord.HTTPException as e:
        print(f"reply send failed: {e}", file=sys.stderr)


