async def _assert_presence(reason: str) -> None:
    """Best-effort presence refresh — failures are logged, never raised, so
    a presence hiccup can't break watchers or the ready path."""
    global _presence_last_attempt
    _presence_last_attempt = time.monotonic()
    try:
        await client.change_presence(status=discord.Status.online)
