def _is_known_verb(text: str) -> bool:
    """Detect un-prefixed legacy command vs freeform chat (mg-a0f3).

    Returns True iff the first whitespace-separated token of `text` is a
    recognized command verb, or `text` begins with one of the colon-suffixed
    verbs (`idea:` / `bug:`). The slash-prefixed form skips this check.
    """
    low = text.strip().lower()
    if not low:
        return False
    if any(low.startswith(p) for p in COMMAND_VERB_PREFIXES):
        return True
    first = low.split(None, 1)[0]
    return first in COMMAND_VERBS


