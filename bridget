def _log(msg: str) -> None:
    """Write a UTC-timestamped line to stderr (captured by launchd into bridget.log).

    Used for diagnostic events whose timing matters for tracing uncommanded
    restarts: on_ready fires, restart command invocations, and Discord
    HTTPException catches that could race into client.close() (mg-5d0e).
    """
    print(
        f'[{datetime.datetime.now(datetime.timezone.utc).isoformat()}] {msg}',
        file=sys.stderr,
        flush=True,
    )


