async def watch_task_transitions(user: discord.User):
    states, file_existed = load_task_states()
    primed = file_existed  # if cache file existed, treat first tick as a normal diff
    while not client.is_closed():
        try:
            rc, out, err = run_mg(['list', '--json', '--all'])
            if rc != 0:
                print(f'watch_task_transitions mg list failed: {err.strip()[:200]}', file=sys.stderr)
                await asyncio.sleep(POLL_INTERVAL)
                continue

            seen_ids = set()
            transitions = []
            for line in out.splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    task = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if task.get('type') != 'task':
                    continue
                tid = task.get('id')
                status = task.get('status')
                if not tid or not status:
                    continue
                seen_ids.add(tid)
                prev = states.get(tid)
                if primed and prev != status and status in _TRANSITION_FORMATS:
                    msg = format_transition(task, status)
                    if msg:
                        transitions.append(msg)
                states[tid] = status

            for stale in set(states.keys()) - seen_ids:
                del states[stale]

            if not primed:
                primed = True
            else:
                for msg in transitions:
                    try:
                        await send_dm_chunked(user, msg)
                    except discord.HTTPException as e:
                        _log(f'HTTPException in watch_task_transitions send: {e}')

            save_task_states(states)
        except Exception as e:
            print(f'watch_task_transitions loop error: {e}', file=sys.stderr)
        await asyncio.sleep(POLL_INTERVAL)


def format_chat_dm(agent_name: str, body: str) -> str:
    """Render the user-facing DM line for an agent → user chat message.

    Format: `[From <agent-name>]: <body>` (mg-c05a). Trailing whitespace
    on the body is stripped so the DM doesn't show a dangling blank line
    after parse_mail's body extraction.
    """
    return f'[From {agent_name}]: {body.rstrip()}'


def _parse_chat_drop_attachments(content: str) -> list[Path]:
    """Pull the optional `Attachments:` header value(s) from a chat-drop.

    The envelope format is a list of `Key: value` headers terminated by
    a blank line, then the body. Attachments may appear as a single
    header line — `Attachments: /path/to/file` — followed by zero or
    more continuation lines that begin with whitespace (one path per
    line, leading whitespace stripped). Returns absolute Paths in
    declaration order. An empty list means the drop has no attachments,
    which is the case for every pre-ds-ff7c chat drop (backward
    compatible)."""
    lines = content.splitlines()
    paths: list[str] = []
    in_attach = False
    for line in lines:
        if line == '':
            break
        low = line.lower()
        if low.startswith('attachments:'):
            first = line.split(':', 1)[1].strip()
            if first:
                paths.append(first)
            in_attach = True
            continue
        if in_attach and line and line[0] in (' ', '\t'):
            stripped = line.strip()
            if stripped:
                paths.append(stripped)
            continue
        # Any non-continuation line ends the Attachments block.
        in_attach = False
    return [Path(p) for p in paths if p]


async def _send_dm_with_attachments(target, body: str, file_paths: list[Path]) -> None:
    """Send `body` plus `file_paths` to the DM target as a single send.

    If `body` exceeds DM_CHUNK_SIZE, the first chunk carries the files
    and subsequent chunks follow as text-only DMs (mirrors
    send_dm_chunked's pacing). When `file_paths` is empty this falls
    through to send_dm_chunked unchanged."""
    if not file_paths:
        await send_dm_chunked(target, body)
        return
    files = [discord.File(str(p)) for p in file_paths]
    if body and body.strip():
        chunks = _split_for_dm(body)
        first = chunks[0]
        await target.send(content=first, files=files)
        for chunk in chunks[1:]:
            if chunk:
                await asyncio.sleep(DM_CHUNK_DELAY)
                await target.send(chunk)
    else:
        # File-only drops are valid — discord.py accepts a send() with
        # files= and no content.
        await target.send(files=files)


async def watch_chat(user) -> None:
    """Poll BRIDGET_CHAT_DIR/new for chat drops; DM each then move to cur/.

    Mirrors Robin's poll_chat_inbox: agents call `bridget chat <name>
    <body>` which writes a file to new/; this loop picks it up, formats
    `[From <name>]: <body>` and emits via send_dm_chunked (mg-a3ef
    handles >1800-char bodies). When the drop carries an `Attachments:`
    header (ds-ff7c) the listed files are attached to the outbound DM;
    drops whose attachments total >25 MiB are rejected with a chat-
    buffer entry written back to the sender so the next read surfaces
    the failure. On success the file is renamed into cur/ so a daemon
    restart won't re-deliver. Per-file errors leave the file in new/
    for retry on the next tick.
    """
    new_dir = BRIDGET_CHAT_DIR / 'new'
    cur_dir = BRIDGET_CHAT_DIR / 'cur'
    while not client.is_closed():
        try:
            new_dir.mkdir(parents=True, exist_ok=True)
            cur_dir.mkdir(parents=True, exist_ok=True)
            for fname in sorted(p.name for p in new_dir.iterdir() if p.is_file()):
                if fname.endswith('.tmp'):
                    continue
                src = new_dir / fname
                dst = cur_dir / fname
                try:
                    raw = src.read_text(encoding='utf-8', errors='replace')
                    mail = parse_mail(raw)
                    att_paths = _parse_chat_drop_attachments(raw)
                    # Filter missing paths defensively — the CLI cached
                    # them, but the cache dir is user-mutable.
                    resolved: list[Path] = []
                    missing: list[str] = []
                    for p in att_paths:
                        if p.is_file():
                            resolved.append(p)
                        else:
                            missing.append(str(p))
                    total_size = sum(p.stat().st_size for p in resolved)
                    if total_size > CHAT_ATTACHMENT_SIZE_LIMIT:
                        # Refuse the drop, surface to sender via buffer.
                        mb = CHAT_ATTACHMENT_SIZE_LIMIT // (1024 * 1024)
                        sender = mail.get('from') or 'unknown'
                        append_chat_buffer(
                            sender,
                            (
                                f'⚠️ outbound chat drop rejected: '
                                f'attachments total {total_size} bytes '
                                f'exceed the {mb} MiB cap'
                            ),
                        )
                        _log(
                            f'watch_chat: rejected {fname} for size '
                            f'({total_size}B > {CHAT_ATTACHMENT_SIZE_LIMIT}B)'
                        )
                        os.rename(src, dst)
                        continue
                    if missing:
                        _log(
                            f'watch_chat: {fname} skipping missing '
                            f'attachment(s): {", ".join(missing)}'
                        )
                    msg = format_chat_dm(mail['from'], mail['body'])
                    await _send_dm_with_attachments(user, msg, resolved)
                    os.rename(src, dst)
                except discord.HTTPException as e:
                    _log(f'HTTPException in watch_chat send ({fname}): {e}')
                except Exception as e:
                    print(f'watch_chat per-file error ({fname}): {e}',
                          file=sys.stderr)
        except Exception as e:
            print(f'watch_chat loop error: {e}', file=sys.stderr)
        await asyncio.sleep(POLL_INTERVAL)


def run_mg(args: list[str]) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            [MG_BIN, *args],
            capture_output=True, text=True, timeout=30,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, '', 'mg command timed out'
    except FileNotFoundError:
        return 127, '', f'mg not found at {MG_BIN}'


def route_recipient(mg_id: str) -> str:
    """Mailbox for a human reply: routes to the mg item's Assignee."""
    rc, out, err = run_mg(['show', mg_id])
    if rc != 0:
        print(
            f'route_recipient: mg show {mg_id} failed (rc={rc}); '
            f'falling back to designer. err={err.strip()[:200]}',
            file=sys.stderr,
        )
        return 'designer'
    m = re.search(r'^Assignee:\s+(\S+)', out, re.MULTILINE)
    if not m:
        print(
            f'route_recipient: no Assignee: line in mg show {mg_id}; '
            f'falling back to designer.',
            file=sys.stderr,
        )
        return 'designer'
    return m.group(1).strip()


def run_pogo(args: list[str]) -> tuple[int, str, str]:
    pogo_bin = CONFIG.get('pogo_bin') or shutil.which('pogo')
    if not pogo_bin:
        return 1, '', 'pogo binary not found (install pogo or set POGO_BIN)'
    try:
        r = subprocess.run(
            [pogo_bin, *args],
            capture_output=True, text=True, timeout=30,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, '', 'pogo command timed out'


def run_shell(args: list[str], timeout: int = 30, cwd=None) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            args, capture_output=True, text=True, timeout=timeout, cwd=cwd,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, '', f'command timed out: {args[0] if args else "?"}'
    except FileNotFoundError:
        return 127, '', f'command not found: {args[0] if args else "?"}'


FRONTMATTER_RE = re.compile(r'\A---\s*\n.*?\n---\s*\n', re.DOTALL)
FRONTMATTER_STATUS_RE = re.compile(r'^status:\s*(\S+)', re.MULTILINE)
FRONTMATTER_TITLE_RE = re.compile(r'^title:\s*(.+)$', re.MULTILINE)

# Canonical work-item id form used by the `open` command. Prefix is left
# open so new families (ds-, rp-, pj-, …) work without code changes
# (mg-f282). The same case-insensitive hex shape mg/dr/ds/rp/pj work
# items emit elsewhere.
MG_ID_RE = re.compile(r'^[a-z]+-[0-9a-f]+$')

# Design-id prefixes that `read <id>` redirects to `open <id>`. Reading
# designs through `read` was deprecated in mg-d3d7 in favor of `open`;
# ds- joined mg- as a design prefix in mg-f282. Non-design prefixes
# (dr-, rp-, pj-, …) keep the find_mails_for/design_doc fallthrough.
DESIGN_ID_RE = re.compile(r'^(mg|ds)-[0-9a-f]+$')


def read_design_status(mg_id: str) -> str | None:
    """Return the frontmatter status field for a design, or None."""
    path = DESIGNS_DIR / f'{mg_id}.md'
    try:
        text = path.read_text()
    except (FileNotFoundError, NotADirectoryError, PermissionError, OSError):
        return None
    m = FRONTMATTER_RE.match(text)
    if not m:
        return None
    fm = m.group(0)
    sm = FRONTMATTER_STATUS_RE.search(fm)
    return sm.group(1) if sm else None


def read_design_doc(mg_id: str) -> str | None:
    """Return the design doc body for mg_id with YAML frontmatter stripped.

    Returns None if the file is missing or unreadable. Designs that lack
    frontmatter are returned verbatim.
    """
    path = DESIGNS_DIR / f'{mg_id}.md'
    try:
        text = path.read_text()
    except (FileNotFoundError, NotADirectoryError, PermissionError, OSError):
        return None
    return FRONTMATTER_RE.sub('', text, count=1).lstrip('\n')


def chunk_for_discord(text: str, limit: int = 1700, max_chunks: int = 3) -> list[str]:
    """Split text for Discord's per-message budget.

    Prefers `\\n## ` section boundaries; falls back to hard splits at `limit`
    when a single section exceeds the budget. If max_chunks is exceeded,
    drops the rest and appends a truncation footer to the last emitted chunk.
    """
    if not text:
        return ['']
    sections: list[str] = []
    if '\n## ' in text:
        first, _, rest = text.partition('\n## ')
        sections.append(first)
        for part in rest.split('\n## '):
            sections.append('## ' + part)
    else:
        sections = [text]

    chunks: list[str] = []
    cur = ''
    for sec in sections:
        if len(sec) > limit:
            if cur:
                chunks.append(cur)
                cur = ''
            for i in range(0, len(sec), limit):
                chunks.append(sec[i:i + limit])
            continue
        candidate = sec if not cur else f'{cur}\n{sec}'
        if len(candidate) <= limit:
            cur = candidate
        else:
            if cur:
                chunks.append(cur)
            cur = sec
    if cur:
        chunks.append(cur)

    if len(chunks) > max_chunks:
        kept = chunks[:max_chunks]
        kept[-1] = (
            kept[-1].rstrip()
            + f'\n…[truncated; full doc at {DESIGNS_DIR}]'
        )
        return kept
    return chunks


# --- send_dm_chunked (mg-a3ef): split long DMs into sequential messages ----
#
# Robin (the Discord ↔ pogo bridge on Ocean) handles long agent output by
# splitting on newline boundaries and sending pieces back-to-back. Bridget
# previously truncated at DISCORD_MSG_LIMIT with an ellipsis, dropping
# content. This helper matches Robin's split-and-stream approach so the
# full body lands in DMs.
#
# Two layers:
#   _split_for_dm(body, max_chars) — pure: paragraph/line split with
#       ``` fence repair across cuts (close + reopen with same lang tag).
#   send_dm_chunked(target, body, chunk_size) — async: drives target.send
#       per chunk with a fixed inter-chunk sleep (Discord per-DM cap is
#       ~5/5s; 0.25s ⇒ ≤4/s burst, well under).
# Empty / whitespace-only bodies are no-ops (Discord rejects empty msgs).

DM_CHUNK_SIZE = 1800        # under Discord's 2000-char hard cap, leaving room for framing.
DM_CHUNK_DELAY = 0.25       # seconds between sequential chunks.
# Reserved per chunk for fence-repair tokens (```lang prefix + \n``` suffix).
_DM_FENCE_RESERVE = 16


def _line_opens_or_closes_fence(line: str) -> tuple[bool, str]:
    """If `line` starts with ``` (after leading whitespace), return (True, lang).

    `lang` is whatever follows the opening fence (e.g. 'python', '') with
    surrounding whitespace stripped. Closing fences yield ('', True) too —
    the caller tracks open/close by toggling state.
    """
    stripped = line.lstrip()
    if not stripped.startswith('```'):
        return False, ''
    return True, stripped[3:].strip()


def _split_for_dm(body: str, max_chars: int = DM_CHUNK_SIZE) -> list[str]:
    """Split `body` into chunks of ≤ `max_chars`, preserving markdown.

    Strategy:
    - If body fits, return as-is.
    - Greedy-pack paragraphs (\\n\\n separated); paragraphs that are
      themselves too long get sub-split by line; lines longer than budget
      are hard-cut (rare — overlong unbroken tokens).
    - After packing, repair ``` fences: any chunk that closes mid-fence
      gets a trailing \\n``` and the next chunk is prefixed with ```<lang>
      so syntax highlighting survives the split. The pack budget reserves
      _DM_FENCE_RESERVE chars for these repair tokens.
    """
    if not body:
        return ['']
    if len(body) <= max_chars:
        return [body]

    safe_budget = max(1, max_chars - _DM_FENCE_RESERVE)
    raw = _greedy_pack_paragraphs(body, safe_budget)
    return _repair_fences(raw, max_chars)


def _greedy_pack_paragraphs(body: str, budget: int) -> list[str]:
    """Pack \\n\\n-separated paragraphs into ≤budget chunks (no fence repair)."""
    chunks: list[str] = []
    current = ''
    for para in body.split('\n\n'):
        sep = '\n\n' if current else ''
        if len(current) + len(sep) + len(para) <= budget:
            current = current + sep + para
            continue
        if current:
            chunks.append(current)
            current = ''
        if len(para) <= budget:
            current = para
            continue
        line_chunks = _pack_lines(para, budget)
        chunks.extend(line_chunks[:-1])
        current = line_chunks[-1]
    if current:
        chunks.append(current)
    return chunks


def _pack_lines(para: str, budget: int) -> list[str]:
    """Sub-split a single paragraph (no \\n\\n) by line boundaries."""
    chunks: list[str] = []
    current = ''
    for line in para.split('\n'):
        sep = '\n' if current else ''
        if len(current) + len(sep) + len(line) <= budget:
            current = current + sep + line
            continue
        if current:
            chunks.append(current)
            current = ''
        if len(line) <= budget:
            current = line
            continue
        for i in range(0, len(line), budget):
            chunks.append(line[i:i + budget])
        current = ''
    if current:
        chunks.append(current)
    return chunks or ['']


def _repair_fences(chunks: list[str], max_chars: int) -> list[str]:
    """Auto-close + reopen ``` fences split across chunks.

    For each chunk we walk its lines toggling fence state. If the chunk
    ends mid-fence, append '\\n```'; the next chunk gets a '```<lang>\\n'
    prefix to reopen. `max_chars` is enforced as a final safety net —
    repair tokens are within the reserve budgeted by the caller.
    """
    if not chunks:
        return chunks
    repaired: list[str] = []
    open_lang: str | None = None
    for chunk in chunks:
        prefix = ''
        if open_lang is not None:
            prefix = '```' + open_lang + '\n'
        body = prefix + chunk
        # Walk lines from a clean state — the prefix's ``` line (if any)
        # re-toggles new_open to the carried lang on its own, so we don't
        # double-count by seeding with open_lang here.
        new_open: str | None = None
        for line in body.split('\n'):
            toggled, lang = _line_opens_or_closes_fence(line)
            if not toggled:
                continue
            new_open = lang if new_open is None else None
        suffix = ''
        if new_open is not None:
            suffix = '\n```'
        repaired.append(body + suffix)
        open_lang = new_open
    return repaired


async def send_dm_chunked(
    target,
    body: str,
    chunk_size: int = DM_CHUNK_SIZE,
    delay: float = DM_CHUNK_DELAY,
) -> None:
    """Send `body` via `target.send()`, splitting into multiple DMs if long.

    `target` is any object with an async `.send(text)` method (discord
    User / Member / DMChannel / Messageable). Chunks are emitted in order
    with `delay` seconds between them so we stay under Discord's per-DM
    burst limit (discord.py also handles 429s internally; this delay is
    extra cushion).

    Empty / whitespace-only bodies are silent no-ops — Discord rejects
    empty messages and they would otherwise raise HTTPException.

    Raises whatever `target.send()` raises — callers wrap in try/except
    to match the existing per-DM error model.
    """
    if not body or not body.strip():
        return
    chunks = _split_for_dm(body, chunk_size)
    for i, chunk in enumerate(chunks):
        if not chunk:
            continue
        if i > 0:
            await asyncio.sleep(delay)
        await target.send(chunk)


def find_mails_for(mg_id: str) -> list:
    """Return [(path, mail_dict, dir_name)] for mails referencing mg_id, newest first."""
    out = []
    needle = mg_id.lower()
    for d in ('new', 'cur'):
        ddir = MAIL_DIR.parent / d
        if not ddir.exists():
            continue
        for p in sorted(ddir.iterdir(), reverse=True):
            try:
                content = p.read_text()
                if needle in content.lower():
                    out.append((p, parse_mail(content), d))
            except Exception:
                pass
    return out


# Subject-line prefixes for mails that require an explicit action verb
# (approve / reject / revise / explain) to be marked read. `dismiss` and
# `dismiss all` skip mails whose Subject matches one of these prefixes.
# Add new prefixes here as more action-required workflows ship.
PROTECTED_SUBJECT_PREFIXES = (
    'Report ready:',     # director → human, awaiting approve/reject/revise
    'approval needed',   # designer → human, awaiting approve/reject/revise
)


def _mail_subject(content: str) -> str:
    """First Subject: header from a mail file, or '' if absent."""
    for line in content.splitlines():
        if line == '':
            return ''
        if line.startswith('Subject: '):
            return line[len('Subject: '):]
    return ''


def mark_mail_read(mg_id=None, all_unread: bool = False,
                   protect_actionable: bool = False) -> int:
    """Move mails from human/new/ → human/cur/. If mg_id is set, only mails
    whose subject/body references that id; if all_unread is True, every mail.
    When protect_actionable is True, mails whose Subject begins with any
    PROTECTED_SUBJECT_PREFIXES entry are skipped (left in new/).
    Returns the count actually moved."""
    if not MAIL_DIR.exists():
        return 0
    cur_dir = MAIL_DIR.parent / 'cur'
    cur_dir.mkdir(parents=True, exist_ok=True)
    n = 0
    for p in sorted(MAIL_DIR.iterdir()):
        try:
            if all_unread:
                if protect_actionable:
                    subj = _mail_subject(p.read_text())
                    if any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES):
                        continue
                p.rename(cur_dir / p.name)
                n += 1
                continue
            if mg_id is None:
                continue
            content = p.read_text()
            # Match the mg-id case-insensitively; covers headers and body.
            if mg_id.lower() in content.lower():
                if protect_actionable:
                    subj = _mail_subject(content)
                    if any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES):
                        continue
                p.rename(cur_dir / p.name)
                n += 1
        except Exception as e:
            print(f"mark_mail_read error on {p.name}: {e}", file=sys.stderr)
    return n


# Statuses indicating an mg work item is no longer actionable: surfacing
# its Report-ready / approval-needed mail in inbox would be stale noise.
_CLOSED_MG_STATUSES = frozenset({'shelved', 'done', 'archived'})


def _mg_item_closed(mg_id: str) -> bool:
    """True iff `mg show mg_id` reports a closed status (shelved/done/archived).

    Defensive: any failure (rc!=0, no Status: line, unexpected output) returns
    False so the caller surfaces the mail — false positive is preferable to
    false negative for inbox visibility.
    """
    rc, out, _ = run_mg(['show', mg_id])
    if rc != 0:
        return False
    m = re.search(r'^Status:\s+(\S+)', out, re.MULTILINE)
    if not m:
        return False
    return m.group(1) in _CLOSED_MG_STATUSES


def _clear_approval_mail(mg_id: str) -> int:
    """Move matching 'approval needed mg_id' mails from human/new/ to human/cur/.

    Narrow textual match: subject must start with 'Subject: approval needed '
    and contain mg_id. Independent of mg state — the _mg_item_closed filter
    in scan_pending_approvals stays as belt-and-suspenders.

    Returns count moved. Defensive on IO errors; never crashes.
    """
    if not MAIL_DIR.exists():
        return 0
    cur_dir = MAIL_DIR.parent / 'cur'
    cur_dir.mkdir(exist_ok=True)
    moved = 0
    for p in sorted(MAIL_DIR.iterdir()):
        try:
            for line in p.read_text().splitlines():
                if line == '':
                    break
                if line.startswith('Subject: approval needed ') and mg_id in line:
                    p.rename(cur_dir / p.name)
                    moved += 1
                    break
        except Exception:
            pass
    return moved


def scan_pending_approvals() -> list[str]:
    """Subjects of unread mails in human/new/ that are approval requests.

    Skips mails whose mg-id is shelved/done/archived — those approvals are
    no longer actionable (item was routed elsewhere before human acted).
    """
    if not MAIL_DIR.exists():
        return []
    out = []
    for p in sorted(MAIL_DIR.iterdir()):
        try:
            for line in p.read_text().splitlines():
                if line == '':
                    break
                if line.startswith('Subject: approval needed '):
                    subj = line[len('Subject: '):]
                    m = re.search(r'[a-z]+-[0-9a-f]+', subj)
                    if m and _mg_item_closed(m.group(0)):
                        break
                    out.append(subj)
                    break
        except Exception:
            pass
    return out


def scan_pending_reports() -> list[str]:
    """Subjects of unread mails in human/new/ that are director Reports.

    Skips mails whose mg-id is shelved/done/archived — those Reports are
    stale (work item was closed before the human acted on the Report).
    """
    if not MAIL_DIR.exists():
        return []
    out = []
    for p in sorted(MAIL_DIR.iterdir()):
        try:
            for line in p.read_text().splitlines():
                if line == '':
                    break
                if line.startswith('Subject: Report ready:'):
                    subj = line[len('Subject: '):]
                    m = re.search(r'[a-z]+-[0-9a-f]+', subj)
                    if m and _mg_item_closed(m.group(0)):
                        break
                    out.append(subj)
                    break
        except Exception:
            pass
    return out


def _inbox_top_list_should_hide(p) -> bool:
    """True if mail file should be hidden from the top 'Unread mail to human' list.

    Returns True only for approval/Report mails whose referenced mg-id has a
    closed status (shelved/done/archived). Generic mails — anything not
    matching the two protected subject prefixes — always pass through. Mirrors
    the same filter scan_pending_approvals/scan_pending_reports apply at the
    bucket level, so the top list and the bucket lists stay in sync.
    """
    try:
        text = p.read_text()
    except Exception:
        return False
    subj = None
    for line in text.splitlines():
        if line == '':
            break
        if line.startswith('Subject: '):
            subj = line[len('Subject: '):]
            break
    if not subj:
        return False
    if not (subj.startswith('approval needed ') or
            subj.startswith('Report ready:')):
        return False
    m = re.search(r'[a-z]+-[0-9a-f]+', subj)
    if not m:
        return False
    return _mg_item_closed(m.group(0))


def get_inbox_summary() -> str:
    """Decide queue: unread mail, pending approvals, pending Reports."""
    parts = []

    unread_raw = sorted(MAIL_DIR.iterdir()) if MAIL_DIR.exists() else []
    unread = [p for p in unread_raw if not _inbox_top_list_should_hide(p)]
    parts.append(f"📬 Unread mail to human: **{len(unread)}**")

    if unread:
        for i, p in enumerate(unread, start=1):
            try:
                mail = parse_mail(p.read_text())
                haystack = (mail['subject'] + ' ' + mail['body']).lower()
                ids = sorted(set(re.findall(r'[a-z]+-[0-9a-f]+', haystack)))
                id_str = ', '.join(ids) if ids else '(no mg-id)'
                subj = mail['subject'][:60]
                parts.append(f'  • [m{i} / {id_str}] {mail["from"]}: {subj}')
            except Exception:
                parts.append(f'  • [m{i}] (parse error: {p.name})')

    approvals = scan_pending_approvals()
    if approvals:
        parts.append("\n**Pending approvals:**")
        for s in approvals:
            parts.append(f"• {s}")

    reports = scan_pending_reports()
    if reports:
        parts.append("\n**Pending reports:**")
        for s in reports:
            parts.append(f"• {s}")

    return '\n'.join(parts)


# Order in which status sections render; empty buckets are omitted.
STATUS_SECTION_ORDER = ('Projects', 'Reports', 'Designs', 'Bugs', 'Tasks', 'Other')

# Legacy lifecycle tags that used to mark a Type=idea as a Project. Kept
# around for backward-compat suppression: during the transition window
# (mg-1d2b Phase 5) any Type=idea items still carrying one of these tags
# are hidden from Designs. They'll bucket normally once retyped to
# Type=project (mg edit --type=project).
_PROJECT_TAGS = frozenset({
    # canonical 5-state vocab (target end-state)
    'scheduled', 'ready-for-kickoff', 'in-progress',
    'done', 'cancelled',
    # current mayor-flow lifecycle tags
    'kickoff-pending', 'kickoff-done', 'roadmap-drafted',
    'handed-off-to-mayor', 'staged',
})

# Transitional fallback (per project-status-tag-convention memory
# 2026-05-15). PRIMARY signal for In Progress is now mg native status
# == 'claimed'. This tag set lets us continue showing in-flight
# projects whose mayor hasn't migrated their status from 'available'
# (with legacy active tags) to 'claimed' yet. Remove this set + the
# fallback branch in categorize_in_flight once all in-flight projects
# are claimed.
_ACTIVE_PROJECT_TAGS = frozenset({
    'in-progress',
    'kickoff-done',
    'handed-off-to-mayor',
})

# mg item-type → status section. Anything not listed falls into "Other".
_TYPE_TO_SECTION = {
    'report': 'Reports',
    'idea':   'Designs',
    'bug':    'Bugs',
    'task':   'Tasks',
}

def categorize_in_flight(items: list[dict]) -> dict[str, list[dict]]:
    """Bucket in-flight items by type. Unknown types fall into 'Other'.

    Type=project items bucket into 'Projects' when mg's native status is
    `claimed` (mayor has claimed the project = In Progress, per the
    project-status-tag-convention 2026-05-15). During the convention-
    migration window a transitional fallback also buckets `available`-
    status projects carrying any legacy active tag in `_ACTIVE_PROJECT_TAGS`
    so in-flight projects whose mayor hasn't migrated their status from
    'available' to 'claimed' yet still show up. All other Type=project
    items (Scheduled / Ready-for-Kickoff / Done / Cancelled) are hidden
    — they live on the Product Roadmap, not the status view.

    Type=idea items still carrying legacy _PROJECT_TAGS lifecycle tags
    are suppressed entirely during the mg-1d2b Phase 5 transition window
    — they must NOT appear in Designs. Once retyped to Type=project they
    bucket normally.

    Type=report items tagged 'approved' are filtered out — they've been
    scheduled into a Project, and the Project entry takes over visibility.
    """
    buckets: dict[str, list[dict]] = {s: [] for s in STATUS_SECTION_ORDER}
    for item in items:
        tags = set(item.get('tags') or [])
        item_type = item.get('type')
        if item_type == 'report' and 'approved' in tags:
            continue
        if item_type == 'project':
            status = item.get('status')
            if status == 'claimed':
                buckets['Projects'].append(item)
                continue
            if status == 'available' and _ACTIVE_PROJECT_TAGS & tags:
                buckets['Projects'].append(item)
            continue  # other states hidden — live on Roadmap
        if item_type == 'idea' and _PROJECT_TAGS & tags:
            continue  # legacy un-retyped Project: hide from Designs
        section = _TYPE_TO_SECTION.get(item_type, 'Other')
        buckets[section].append(item)
    return buckets


def derive_review_label(item: dict) -> str:
    """For report items with an unread Report-ready mail in human/new/,
    return 'review'. Otherwise return the item's mg status verbatim."""
    status = item.get('status', '?')
    if item.get('type') != 'report':
        return status
    iid = (item.get('id') or '').lower()
    if not iid or not MAIL_DIR.exists():
        return status
    needle = f'subject: report ready: {iid}'
    for p in MAIL_DIR.iterdir():
        try:
            for line in p.read_text().splitlines():
                if line == '':
                    break
                if line.lower().startswith(needle):
                    return 'review'
        except Exception:
            pass
    return status


def get_status_summary() -> str:
    """In-flight work, categorized by type (Reports / Designs / Bugs / Tasks)."""
    rc, out, err = run_mg(['list', '--json'])
    in_flight: list[dict] = []
    mg_error = None
    if rc == 0:
        for line in out.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
                if d.get('status') in ('available', 'claimed', 'pending'):
                    in_flight.append(d)
            except json.JSONDecodeError:
                pass
    elif err:
        mg_error = err.strip()[:200]

    buckets = categorize_in_flight(in_flight)

    parts = []
    for section in STATUS_SECTION_ORDER:
        items = buckets[section]
        if not items:
            continue
        if parts:
            parts.append('')
        parts.append(f"**{section}**")
        for d in items:
            iid = d.get('id', '?')
            label = derive_review_label(d)
            title = (d.get('title') or '?')[:80]
            parts.append(f"[{iid}] {label}: {title}")

    if not parts:
        out_str = "No work in flight."
    else:
        out_str = '\n'.join(parts)

    if mg_error:
        out_str = out_str + f"\n\n(mg list error: {mg_error})"
    return out_str


# ── spend: live Anthropic rate-limit probe ──────────────────────────────────
# The Anthropic API returns rate-limit headers on every response. We make a
# minimal probe (max_tokens=1) and parse the response headers. The API surfaces
# input-tokens and output-tokens windows; the 5-hour session and weekly windows
# from the original mg-cac7 mockup are Claude Code subscription concepts and
# are not exposed via the API. See CHANGELOG for the documented limitation.

QUOTA_PROBE_MODEL = 'claude-haiku-4-5-20251001'
QUOTA_HEADER_KEYS = ('input-tokens', 'output-tokens')


def _probe_anthropic_quota():
    api_key = os.environ.get('ANTHROPIC_API_KEY')
    if not api_key:
        return None
    req = urllib.request.Request(
        'https://api.anthropic.com/v1/messages',
        method='POST',
        headers={
            'x-api-key': api_key,
            'anthropic-version': '2023-06-01',
            'content-type': 'application/json',
        },
        data=json.dumps({
            'model': QUOTA_PROBE_MODEL,
            'max_tokens': 1,
            'messages': [{'role': 'user', 'content': 'x'}],
        }).encode(),
    )
    try:
        resp = urllib.request.urlopen(req, timeout=10)
        return _parse_quota_headers(dict(resp.headers))
    except urllib.error.HTTPError as e:
        # Even error responses carry rate-limit headers; salvage them if
        # the limit was the cause. Otherwise surface the error.
        try:
            parsed = _parse_quota_headers(dict(e.headers))
            if parsed:
                return parsed
        except Exception:
            pass
        return {'error': f'HTTP {e.code}: {e.reason}'}
    except Exception as e:
        return {'error': str(e)}


def _parse_quota_headers(headers: dict) -> dict:
    # Case-insensitive lookup. urllib's response.headers is already case-
    # insensitive but plain dicts from tests aren't, so normalize.
    lower = {k.lower(): v for k, v in headers.items()}
    out = {}
    for key in QUOTA_HEADER_KEYS:
        limit = lower.get(f'anthropic-ratelimit-{key}-limit')
        remaining = lower.get(f'anthropic-ratelimit-{key}-remaining')
        reset = lower.get(f'anthropic-ratelimit-{key}-reset')
        if limit is None or remaining is None:
            continue
        try:
            out[key] = {
                'limit': int(limit),
                'remaining': int(remaining),
                'reset': reset,
            }
        except (TypeError, ValueError):
            continue
    return out


def _format_quota_duration(seconds: float) -> str:
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f'{seconds}s'
    if seconds < 3600:
        m, s = divmod(seconds, 60)
        return f'{m}m {s}s' if s else f'{m}m'
    if seconds < 86400:
        h, rem = divmod(seconds, 3600)
        m = rem // 60
        return f'{h}h {m}m' if m else f'{h}h'
    d, rem = divmod(seconds, 86400)
    h = rem // 3600
    return f'{d}d {h}h' if h else f'{d}d'


def _format_quota(quota: dict, now: float | None = None) -> str:
    if not quota:
        return 'Quota probe returned no rate-limit headers.'
    if now is None:
        now = time.time()
    labels = {'input-tokens': 'Input tokens', 'output-tokens': 'Output tokens'}
    lines = ['Token quota:']
    for key in QUOTA_HEADER_KEYS:
        window = quota.get(key)
        if not window:
            continue
        limit = window['limit']
        remaining = window['remaining']
        used = max(0, limit - remaining)
        pct = (used * 100 // limit) if limit > 0 else 0
        reset = window.get('reset')
        if reset:
            try:
                reset_dt = _parse_iso_utc(reset)
                refresh = _format_quota_duration(reset_dt.timestamp() - now)
                tail = f' → refresh in {refresh}'
            except (ValueError, TypeError):
                tail = ''
        else:
            tail = ''
        lines.append(f'  {labels[key]+":":<15} {pct}% used{tail}')
    return '\n'.join(lines)


def _librarian_search_root() -> Path:
    override = os.environ.get('CONFLUENCE_DATA_DIR')
    if override:
        return Path(override).expanduser()
    return LIBRARIAN_DATA_DIR_DEFAULT


def _format_librarian_search_results(rg_stdout: str, root: Path) -> str:
    """Group `rg --no-heading --line-number` output by file.

    Output lines have shape `<path>:<lineno>:<content>`. Lines without
    that shape are skipped (covers e.g. an unexpected leading blank).
    Returns the formatted block (Discord markdown), capped at
    LIBRARIAN_SEARCH_OUTPUT_LIMIT with a truncation marker appended
    if the cap is hit. Empty stdout → empty string.
    """
    by_file: dict[str, list[tuple[int, str]]] = {}
    order: list[str] = []
    for raw in rg_stdout.splitlines():
        parts = raw.split(':', 2)
        if len(parts) != 3:
            continue
        path, lineno_str, content = parts
        try:
            lineno = int(lineno_str)
        except ValueError:
            continue
        if path not in by_file:
            by_file[path] = []
            order.append(path)
        by_file[path].append((lineno, content))

    if not order:
        return ''

    blocks = []
    for path in order:
        try:
            rel = Path(path).relative_to(root)
        except ValueError:
            rel = Path(path)
        rel_str = str(rel)
        if rel_str.endswith('.md'):
            rel_str = rel_str[:-3]
        lines = [f'**{rel_str}**']
        for lineno, content in by_file[path]:
            lines.append(f'  L{lineno}: {content.strip()}')
        blocks.append('\n'.join(lines))

    out = '\n\n'.join(blocks)
    if len(out) > LIBRARIAN_SEARCH_OUTPUT_LIMIT:
        out = (
            out[:LIBRARIAN_SEARCH_OUTPUT_LIMIT].rstrip()
            + '\n…(truncated; refine query)'
        )
    return out


def handle_command(text: str) -> str | list[str]:
    """Top-level DM dispatcher (mg-a0f3 slash-command parser).

    Three routes:
    1. `/<verb> …`  → strip slash and dispatch (canonical form).
    2. `<known verb> …` (no slash) → log deprecation, then dispatch. Kept
       for one release so existing reflexes don't break overnight.
    3. anything else → chat-relay (mg-c869): buffer the message for the
       agent set by /route and nudge them with `N new bridget messages`.
    """
    text = text.strip()
    if text.startswith('/'):
        return _dispatch_command(text[1:].lstrip())
    if _is_known_verb(text):
        first = text.split(None, 1)[0] if text.split() else ''
        _log(
            f'deprecated: bridget command `{first}` sent without leading "/" '
            f'prefix; use `/{first}` instead (back-compat drops with chat-relay)'
        )
        return _dispatch_command(text)
    return _route_to_chat_relay(text)


def _route_to_chat_relay(
    text: str,
    attachments: list[dict] | None = None,
) -> str:
    """Buffer a non-slash DM for the current /route target and nudge them.

    Returns a reply for the user. The buffer append always succeeds (it's
    a local fcntl-locked json write); the nudge can fail (no pogo on
    PATH, agent dead) — in that case the message is still buffered and
    the agent will pick it up on its next bridget-mail check, but the
    user sees the nudge error so they know the delivery wasn't immediate.

    `attachments`, when supplied, is the dict list from
    _ingest_attachments — image/PDF entries plus any `rejected:
    too_large` markers. They're persisted alongside the body and render
    as 📎 lines on drain (ds-ff7c)."""
    body = text.strip()
    if not body and not attachments:
        return CHAT_RELAY_EMPTY_REPLY
    if not body:
        # Attachment-only DM: substitute a placeholder body so the
        # drain output isn't a bare `[ts]` line with only 📎 children.
        body = '(attachment)'
    recipient = load_route()
    # mg-4d10: check liveness BEFORE claiming delivery. `pogo nudge` falls
    # back to mail when the agent is down and can still exit 0, so a
    # successful nudge is not evidence that anyone will read this.
    status = route_target_status(recipient)
    count = append_chat_buffer(recipient, body, attachments=attachments)
    plural = '' if count == 1 else 's'
    nudge_msg = f'{count} new bridget message{plural}'
    rc, out, err = run_pogo(['nudge', '--immediate', recipient, nudge_msg])
    if status in (ROUTE_STATUS_STOPPED, ROUTE_STATUS_RETIRED):
        why = (
            'is retired (no prompt on pogod\'s scan path) and can never start'
            if status == ROUTE_STATUS_RETIRED
            else 'is not running'
        )
        hint = (
            f'`/route {DEFAULT_ROUTE}` to reach a live agent'
            if status == ROUTE_STATUS_RETIRED
            else f'`pogo agent start {recipient}`, or `/route {DEFAULT_ROUTE}`'
        )
        return (
            f'⚠️ **NOT DELIVERED** — buffered for `{recipient}` '
            f'({count} pending), but `{recipient}` {why}, so nobody will '
            f'read this. Your message is saved, not lost: {hint}.'
        )
    if rc != 0:
        return (
            f'💬 buffered for `{recipient}` ({count} pending) '
            f'but nudge failed: {(err or out).strip()[:200]}'
        )
    return f'💬 sent to `{recipient}` ({count} pending)'


def _dispatch_command(text: str) -> str | list[str]:
    """Per-verb dispatcher (extracted from handle_command in mg-a0f3).

    Callers must have already stripped any leading slash and decided that
    the text is in fact a command (vs chat-relay). This function still
    enforces the BRIDGET_PROFILE gate and per-verb usage checks.
    """
    text = text.strip()
    low = text.lower()

    # Profile gate (mg-5059): short-circuit Robin-only verbs when running as
    # laptop bridget. 'help <robin-only>' is handled separately in the help
    # branch below, since that input begins with 'help' rather than the gated
    # verb itself.
    if BRIDGET_PROFILE != 'robin':
        for _verb in ROBIN_ONLY_COMMANDS:
            if low == _verb or low.startswith(_verb + ' '):
                return _robin_only_reply(_verb)

    if re.match(r'^approve [a-z]+-', low):
        parts = text.split(None, 1)
        mg_id = parts[1] if len(parts) > 1 else ''
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=approve {mg_id}',
            '--body=approved via discord',
        ])
        if rc == 0:
            n = _clear_approval_mail(mg_id) + mark_mail_read(mg_id=mg_id)
            log_mail_action('approve', mg_id=mg_id)
            tail = f" (cleared {n} related mail{'s' if n != 1 else ''})" if n else ''
            return f"✓ approve sent: `{mg_id}`{tail}"
        return f"✗ failed: {err or out}"

    if re.match(r'^reject [a-z]+-', low):
        parts = text.split(None, 2)
        if len(parts) < 2:
            return "Usage: `/reject mg-XXXX <reason>` (or `dr-XXXX`)"
        mg_id = parts[1]
        reason = parts[2] if len(parts) > 2 else 'rejected via discord'
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=reject {mg_id}',
            f'--body={reason}',
        ])
        if rc == 0:
            n = _clear_approval_mail(mg_id) + mark_mail_read(mg_id=mg_id)
            log_mail_action('reject', mg_id=mg_id)
            tail = f" (cleared {n} related mail{'s' if n != 1 else ''})" if n else ''
            return f"✓ reject sent: `{mg_id}`{tail}"
        return f"✗ failed: {err or out}"

    if re.match(r'^revise [a-z]+-', low):
        parts = text.split(None, 2)
        if len(parts) < 3:
            return "Usage: `/revise mg-XXXX <feedback>` (or `dr-XXXX`)"
        mg_id = parts[1]
        feedback = parts[2]
        sh_rc, sh_out, _ = run_mg(['show', mg_id])
        if sh_rc == 0 and re.search(r'^Status:\s+shelved', sh_out, re.MULTILINE):
            run_mg(['unshelve', mg_id])
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=revise {mg_id}',
            f'--body={feedback}',
        ])
        if rc == 0:
            n = _clear_approval_mail(mg_id) + mark_mail_read(mg_id=mg_id)
            log_mail_action('revise', mg_id=mg_id)
            tail = f" (cleared {n} related mail{'s' if n != 1 else ''})" if n else ''
            return f"✓ revise sent: `{mg_id}`{tail}"
        return f"✗ failed: {err or out}"

    m_index_match = re.match(r'^read\s+m(\d+)$', low)
    if m_index_match:
        n = int(m_index_match.group(1))
        unread = sorted(MAIL_DIR.iterdir()) if MAIL_DIR.exists() else []
        if n < 1 or n > len(unread):
            return (
                f"m{n} not found — inbox has {len(unread)} unread mail"
                f"{'s' if len(unread) != 1 else ''}. Run `/inbox` to refresh."
            )
        p = unread[n - 1]
        try:
            mail = parse_mail(p.read_text())
        except Exception as e:
            return f"✗ failed to read m{n}: {e}"
        # mg-d3d7: `read m<N>` renders the mail directly. The mg-id-referencing
        # mail no longer recurses through `read mg-XXXX` (which is now a hint
        # redirect to `open`). If the user wants the linked design too, they
        # send `open mg-XXXX` as a follow-up.
        subj = mail.get('subject', '')
        protected = any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES)
        state = 'unread (action required)' if protected else 'unread'
        if not protected:
            cur_dir = MAIL_DIR.parent / 'cur'
            cur_dir.mkdir(parents=True, exist_ok=True)
            try:
                p.rename(cur_dir / p.name)
            except Exception as e:
                print(f'auto-mark-read failed for {p.name}: {e}', file=sys.stderr)
        log_mail_action('read', mg_id=None)
        return (
            f"📧 from `{mail['from']}` _({state})_\n"
            f"**{mail['subject']}**\n\n"
            f"{mail['body']}"
        )

    if low == 'open' or low.startswith('open '):
        parts = text.split(None, 1)
        usage = "Usage: `/open mg-XXXX`"
        if len(parts) < 2:
            return usage
        arg = parts[1].strip().lower()
        if not MG_ID_RE.match(arg):
            return usage
        rc, out, _ = run_mg(['show', arg])
        if rc != 0:
            return f'open: mg item {arg} not found'
        title = '?'
        m = re.search(r'^Title:\s+(.+)$', out, re.MULTILINE)
        if m:
            title = m.group(1).strip()
        return f'Notes app → Pogo Designs → **{arg}: {title}**'

    if re.match(r'^read [a-z]+-', low):
        parts = text.split(None, 1)
        if len(parts) < 2:
            return "Usage: `/read mg-XXXX` (or `dr-XXXX`)"
        mg_id = parts[1].strip()

        if DESIGN_ID_RE.match(mg_id.lower()):
            return (
                "`/read` is for mail message-ids; "
                "try `/open mg-XXXX` for designs."
            )

        matches = find_mails_for(mg_id)
        mail_footer = ''
        if matches:
            p, mail, dir_name = matches[0]
            subj = mail.get('subject', '')
            protected = any(subj.startswith(pre) for pre in PROTECTED_SUBJECT_PREFIXES)
            if dir_name == 'new':
                state = 'unread (action required)' if protected else 'unread'
            else:
                state = 'read'
            mail_footer = (
                f"📧 latest mail: **{mail['subject']}** _({state})_"
            )
            if dir_name == 'new' and not protected:
                cur_dir = MAIL_DIR.parent / 'cur'
                cur_dir.mkdir(parents=True, exist_ok=True)
                try:
                    p.rename(cur_dir / p.name)
                    log_mail_action('read', mg_id=mg_id)
                except Exception as e:
                    print(f'auto-mark-read failed for {p.name}: {e}', file=sys.stderr)

        design_body = read_design_doc(mg_id)
        if design_body is not None:
            status = read_design_status(mg_id) or 'unknown'
            header = f"📐 **Design `{mg_id}`** _({status})_"
            footer = f"\n\n---\n{mail_footer}" if mail_footer else ''
            full = f"{header}\n{design_body.rstrip()}{footer}"
            return chunk_for_discord(full)

        if not matches:
            return f"No mail found for `{mg_id}`."
        rest = len(matches) - 1
        rest_note = f"\n\n_({rest} other mail{'s' if rest != 1 else ''} also reference this id; this is the newest.)_" if rest else ''
        return (
            f"📧 from `{mail['from']}` _({state})_\n"
            f"**{mail['subject']}**\n\n"
            f"{mail['body']}"
            f"{rest_note}"
        )

    if low.startswith('dismiss '):
        parts = text.split(None, 1)
        if len(parts) < 2:
            return "Usage: `/dismiss mg-XXXX` (or `dr-XXXX`) or `/dismiss all`"
        arg = parts[1].strip()
        if arg.lower() == 'all':
            n = mark_mail_read(all_unread=True, protect_actionable=True)
            log_mail_action('dismiss-all')
            return f"✓ marked {n} mail{'s' if n != 1 else ''} read (inbox-zero)"
        if re.match(r'^[a-z]+-', arg.lower()):
            n = mark_mail_read(mg_id=arg, protect_actionable=True)
            log_mail_action('dismiss', mg_id=arg)
            return f"✓ marked {n} mail{'s' if n != 1 else ''} read for `{arg}`"
        return "Usage: `/dismiss mg-XXXX` (or `dr-XXXX`) or `/dismiss all`"

    if re.match(r'^explain [a-z]+-', low):
        parts = text.split(None, 2)
        if len(parts) < 3:
            return "Usage: `/explain mg-XXXX <what to explain>` (or `dr-XXXX`)"
        mg_id = parts[1]
        topic = parts[2]
        target = route_recipient(mg_id)
        rc, out, err = run_mg([
            'mail', 'send', target,
            '--from=human',
            f'--subject=explain {mg_id}',
            f'--body={topic}',
        ])
        if rc == 0:
            n = _clear_approval_mail(mg_id) + mark_mail_read(mg_id=mg_id)
            log_mail_action('explain', mg_id=mg_id)
            tail = f" (cleared {n} related mail{'s' if n != 1 else ''})" if n else ''
            return f"✓ explain request sent: `{mg_id}`{tail}"
        return f"✗ failed: {err or out}"

    if low.startswith('nudge '):
        parts = text.split(None, 2)
        if len(parts) < 2:
            return 'Usage: /nudge <agent-name> [reason]'
        agent_name = parts[1]
        reason = parts[2] if len(parts) > 2 else 'status check'
        rc, out, err = run_pogo(['nudge', '--immediate', agent_name, reason])
        if rc != 0:
            return f'✗ nudge failed: {err or out}'
        success = f'✓ nudged {agent_name}: "{reason}"'
        rc2, dout, _ = run_pogo(['agent', 'diagnose', agent_name, '--json'])
        if rc2 != 0:
            return success
        try:
            diag = json.loads(dout)
        except json.JSONDecodeError:
            return success
        tail = strip_ansi(diag.get('recent_output_tail') or '')
        if CREDIT_BALANCE_RE.search(tail):
            return (
                f'⚠️ nudged {agent_name} — but credit balance error in '
                f'recent tail; nudge will likely be ignored. '
                f'Refuel at console.anthropic.com.'
            )
        return success

    if low == 'restart':
        rc, out, err = run_shell(
            ['git', '-C', str(BRIDGET_REPO), 'pull', '--ff-only'], timeout=30,
        )
        if rc != 0:
            return f'❌ git pull failed: {(err or out).strip()[:200]}; staying on old code.'
        rc_sha, sha_out, _ = run_shell(
            ['git', '-C', str(BRIDGET_REPO), 'rev-parse', '--short', 'HEAD'], timeout=10,
        )
        sha = sha_out.strip() if rc_sha == 0 else '?'
        rc_b, _, err_b = run_shell(
            ['bash', 'build.sh'], timeout=10, cwd=str(BRIDGET_REPO),
        )
        if rc_b != 0:
            return f'❌ syntax check failed: {err_b.strip()[:200]}; staying on old code.'
        # 2s gives the Discord ack time to flush before launchd respawns us.
        _log(f'restart command invoked by user {USER_ID}; calling os._exit(0) in 2s')
        client.loop.call_later(2.0, lambda: os._exit(0))
        return f'✅ pulled {sha}; restarting in 2s'

    if low == 'mail' or low.startswith('mail '):
        rest = text[len('mail'):].lstrip()
        if '\n' in rest:
            subject, body = rest.split('\n', 1)
            subject = subject.strip()
            body = body.rstrip()
        else:
            subject = rest.strip()
            body = '(no body)'
        if not subject:
            return 'Usage: /mail <subject>\n[optional body, multi-line OK]'
        recipient = CONFIG['mail_recipient']
        rc, out, err = run_mg([
            'mail', 'send', recipient,
            '--from=human',
            f'--subject={subject}',
            f'--body={body}',
        ])
        if rc == 0:
            return f'✓ mailed {recipient}: "{subject[:60]}"'
        return f'✗ mail failed: {(err or out).strip()[:200]}'

    if low in ('help', '?', 'commands'):
        lines = ['**Commands:**']
        for c in VISIBLE_COMMANDS:
            lines.append(f"• `{c['signature']}`")
        lines.append('')
        lines.append('Type `/help <command>` for details on any one.')
        return '\n'.join(lines)
    if low.startswith('help '):
        name = text.split(None, 1)[1].strip().lower()
        if BRIDGET_PROFILE != 'robin' and _is_robin_only(name):
            return _robin_only_reply(name)
        c = COMMANDS_BY_NAME.get(name)
        if not c:
            return f"Unknown command `{name}`; type `/help` for the menu."
        return f"**`{c['signature']}`**\n\n{c['description']}"

    if low == 'route' or low.startswith('route '):
        parts = text.split(None, 1)
        if len(parts) == 1:
            current = load_route()
            status = route_target_status(current)
            note = ''
            if status == ROUTE_STATUS_STOPPED:
                note = (
                    f"\n⚠️ **{current} is not running** — messages you send "
                    f"now will queue unread."
                )
            elif status == ROUTE_STATUS_RETIRED:
                note = (
                    f"\n⚠️ **{current} is retired** (no prompt on pogod's "
                    f"scan path) — it can never read your messages."
                )
            return (
                f"Current chat route: **{current}**{note}\n"
                f"{describe_route_targets()}\n"
                f"Use `/route <agent>` to change."
            )
        arg = parts[1].strip().lower()
        # mg-4d10: validate against agents that can ACTUALLY run, not a
        # hardcoded tuple. A retired agent's buffer has no drainer, so
        # accepting the route here is silent data loss on the primary
        # human channel.
        status = route_target_status(arg)
        if status == ROUTE_STATUS_RETIRED:
            return (
                f"Cannot route to `{arg}`: it is not running and has no "
                f"prompt on pogod's scan path (`~/.pogo/agents/mayor.md` or "
                f"`~/.pogo/agents/crew/{arg}.md`), so it can never start and "
                f"never read your messages.\n"
                f"{describe_route_targets()}"
            )
        save_route(arg)
        reset_running_agents_cache()
        if status == ROUTE_STATUS_STOPPED:
            return (
                f"⚠️ chat route set to **{arg}**, but **{arg} is not "
                f"running** — it has a prompt but no live process, so your "
                f"messages will sit in the buffer unread until someone runs "
                f"`pogo agent start {arg}`. Start it, or `/route "
                f"{DEFAULT_ROUTE}` to reach a live agent."
            )
        if status == ROUTE_STATUS_UNKNOWN:
            return (
                f"✓ chat route set to **{arg}** — but pogod could not be "
                f"reached to confirm it is running, so delivery is not "
                f"guaranteed."
            )
        return (
            f"✓ chat route set to **{arg}** — "
            f"non-slash messages will go to {arg}."
        )

    if low == 'spend' or low.startswith('spend '):
        # Ignore any args — design reserves them for future use.
        result = _probe_anthropic_quota()
        if result is None:
            return (
                'API key not configured. Add `ANTHROPIC_API_KEY` to '
                '`~/.pogo/bridget.env` to enable.'
            )
        if isinstance(result, dict) and 'error' in result:
            return (
                f"Quota probe failed: {result['error']}. "
                f"Try again or check Claude Code directly."
            )
        return _format_quota(result)

    if low == 'librarian sync' or low.startswith('librarian sync '):
        parts = text.split()
        if len(parts) < 3 or len(parts) > 4:
            return "Usage: `/librarian sync <space> [page-id]`"
        space = parts[2]
        page_id = parts[3] if len(parts) == 4 else None
        if not LIBRARIAN_SPACE_RE.match(space):
            return (
                f"✗ invalid space key `{space}` — must match "
                f"`^[A-Z][A-Z0-9_-]*$` (Confluence space-key shape)"
            )
        if page_id is not None and not LIBRARIAN_PAGE_RE.match(page_id):
            return f"✗ invalid page-id `{page_id}` — must be all digits"
        if os.path.exists(LIBRARIAN_LOCK_PATH):
            return (
                "✗ ingest already running (`/tmp/librarian.lock` exists). "
                "wait for the completion DM, or `rm /tmp/librarian.lock` if "
                "stuck after a bridget crash."
            )
        try:
            fd = os.open(
                LIBRARIAN_LOCK_PATH,
                os.O_CREAT | os.O_EXCL | os.O_WRONLY,
                0o644,
            )
            os.write(fd, f'{os.getpid()} {space} {page_id or ""}\n'.encode())
            os.close(fd)
        except FileExistsError:
            return (
                "✗ ingest already running (`/tmp/librarian.lock` exists). "
                "wait for the completion DM, or `rm /tmp/librarian.lock` if "
                "stuck after a bridget crash."
            )
        except OSError as e:
            return f"✗ failed to acquire lock: {e}"
        script_args = [LIBRARIAN_SCRIPT_PATH, space]
        if page_id is not None:
            script_args.append(page_id)
        # Wrap the script so the lock auto-clears on normal completion.
        # If bridget itself crashes after this point, the lock lingers —
        # CHANGELOG documents the manual rm escape hatch.
        quoted = ' '.join(f'"{a}"' for a in script_args)
        wrapper_cmd = (
            f'{quoted}; rc=$?; rm -f "{LIBRARIAN_LOCK_PATH}"; exit $rc'
        )
        try:
            subprocess.Popen(
                ['/bin/sh', '-c', wrapper_cmd],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as e:
            try:
                os.unlink(LIBRARIAN_LOCK_PATH)
            except OSError:
                pass
            return f"✗ failed to spawn librarian: {e}"
        label = f"{space}/{page_id}" if page_id else space
        return (
            f"🔄 librarian sync started for `{label}`; "
            f"will DM when done."
        )

    if low == 'librarian search' or low.startswith('librarian search '):
        query = text[len('librarian search'):].lstrip()
        if not query:
            return "Usage: `/librarian search <query>`"
        root = _librarian_search_root()
        if not root.exists():
            return f"no Confluence data ingested yet at `{root}`"
        try:
            result = subprocess.run(
                [
                    'rg', '--type=md', '--max-count=2',
                    '--max-columns=200', '--color=never',
                    '--no-heading', '--line-number',
                    query, str(root),
                ],
                capture_output=True,
                text=True,
                timeout=LIBRARIAN_SEARCH_TIMEOUT,
            )
        except FileNotFoundError:
            return (
                'search failed: `rg` not installed '
                '(try `brew install ripgrep`)'
            )
        except subprocess.TimeoutExpired:
            return (
                f'search failed: ripgrep timed out '
                f'(>{LIBRARIAN_SEARCH_TIMEOUT}s); refine query'
            )
        if result.returncode == 1:
            return f"no results for `{query}`"
        if result.returncode != 0:
            err = (result.stderr or result.stdout).strip()
            return f"search failed: {err[:200]}"
        formatted = _format_librarian_search_results(result.stdout, root)
        if not formatted:
            return f"no results for `{query}`"
        return formatted

    if low == 'accountant run-now' or low.startswith('accountant run-now '):
        parts = text.split(None, 2)
        week = parts[2].strip() if len(parts) > 2 else ''
        if week and not ACCOUNTANT_WEEK_RE.match(week):
            return "Usage: `/accountant run-now [YYYY-Www]`"
        if os.path.exists(ACCOUNTANT_LOCK_PATH):
            return (
                f"✗ budget cycle already running "
                f"(`{ACCOUNTANT_LOCK_PATH}` exists). wait for the "
                f"completion DM, or `rm {ACCOUNTANT_LOCK_PATH}` if "
                f"stuck after a wrapper crash."
            )
        script_args = [ACCOUNTANT_SCRIPT_PATH]
        if week:
            script_args.append(week)
        try:
            subprocess.Popen(
                script_args,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as e:
            return f"✗ failed to start budget cycle: {e}"
        label = f' for `{week}`' if week else ''
        return (
            f"🔄 budget cycle started{label}; "
            f"will DM when done."
        )

    if low == 'accountant status':
        out_log = ACCOUNTANT_LOG_PATH
        err_log = ACCOUNTANT_ERR_LOG_PATH
        header = '📊 **Budget cycle status**'
        if not out_log.exists() and not err_log.exists():
            return f"{header}\n  no runs yet"
        out_parts = [header]
        if out_log.exists():
            mtime = datetime.datetime.fromtimestamp(
                out_log.stat().st_mtime, tz=datetime.timezone.utc
            )
            tail = '\n'.join(
                out_log.read_text().splitlines()[-ACCOUNTANT_STATUS_TAIL_LINES:]
            )
            out_parts.append(f"  last stdout: {mtime.isoformat()}")
            out_parts.append(
                f"  ```\n{tail[:ACCOUNTANT_STATUS_TAIL_BUDGET]}\n```"
            )
        if err_log.exists() and err_log.stat().st_size > 0:
            mtime = datetime.datetime.fromtimestamp(
                err_log.stat().st_mtime, tz=datetime.timezone.utc
            )
            tail = '\n'.join(
                err_log.read_text().splitlines()[-ACCOUNTANT_STATUS_TAIL_LINES:]
            )
            out_parts.append(f"  last stderr: {mtime.isoformat()}")
            out_parts.append(
                f"  ```\n{tail[:ACCOUNTANT_STATUS_TAIL_BUDGET]}\n```"
            )
        return '\n'.join(out_parts)

    if low == 'inbox' or low.startswith('inbox '):
        summary = get_inbox_summary()
        if len(summary) > STATUS_OUTPUT_BUDGET:
            summary = summary[:STATUS_OUTPUT_BUDGET] + '\n…(truncated)'
        return summary

    if low == 'status' or low.startswith('status'):
        summary = get_status_summary()
        if len(summary) > STATUS_OUTPUT_BUDGET:
            summary = summary[:STATUS_OUTPUT_BUDGET] + '\n…(truncated)'
        try:
            run_pogo(['nudge', 'crew-mayor', 'status check from human via bridge'])
        except Exception as e:
            print(f'mayor nudge failed: {e}', file=sys.stderr)
        return summary

    return (
        "Unrecognized. Send `/help` for the full command list."
    )


# --- Native Discord slash commands (mg-db57) ----------------------------
#
# Bridget already parses /-prefixed text DMs (mg-a0f3); these wrappers
# expose the same verbs through Discord's native slash UI without
# duplicating handler logic. Each wrapper reconstructs the text-command
# equivalent and forwards into handle_command, which returns the same
# str|list[str] reply as the text path. tree.sync() in on_ready uploads
# the registration to Discord on first connect (mg-db57).
#
# Discord name constraints: lowercase, no colons or spaces. So:
# - `idea:` / `bug:` (colon is part of the text verb) become `/idea`
#   and `/bug`; the wrapper re-inserts the colon when forwarding.
# - Two-word verbs (`librarian sync`, `accountant run-now`, etc.) use
#   hyphenated Discord names matching Robin's `mail-director` convention
#   rather than subcommand groups, since the text parser already keys
#   off space-separated tokens.
#
# USER_ID gate: bridget is single-user, so unknown invokers see an
# ephemeral 'not your bridget' message instead of running mg/pogo
# work under the configured user's identity.

async def _run_slash(interaction, text: str) -> None:
    """Forward a slash invocation into handle_command + reply back.

    Many handlers shell out (run_mg / run_pogo / subprocess.Popen) which
    can blow Discord's 3 s interaction-token window, so we defer() up
    front and emit reply chunks via followup.send() — same shape Robin
    uses for its slash commands."""
    if interaction.user.id != USER_ID:
        await interaction.response.send_message(
            "this bridget only responds to its configured user.",
            ephemeral=True,
        )
        return
    await interaction.response.defer()
    try:
        reply = handle_command(text)
    except Exception as e:  # noqa: BLE001
        _log(f'slash dispatch raised on {text!r}: {e}')
        await interaction.followup.send(f'✗ internal error: {e}')
        return
    chunks = reply if isinstance(reply, list) else [reply]
    chunks = [c for c in chunks if c and c.strip()]
    if not chunks:
        await interaction.followup.send('(empty reply)')
        return
    for chunk in chunks:
        for piece in _split_for_dm(chunk):
            await interaction.followup.send(piece)


def _register_slash_commands(tree) -> None:
    """Register native slash commands that forward into handle_command.

    Called once at module load (after handle_command is defined); the
    tree is uploaded to Discord by tree.sync() in on_ready."""

